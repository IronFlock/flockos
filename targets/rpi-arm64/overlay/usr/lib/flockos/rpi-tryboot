#!/usr/bin/env bash
# RAUC custom bootloader backend for the Raspberry Pi firmware (system.conf
# [handlers] bootloader-custom-backend; master plan, section 3.2; WP-5.2).
#
#   rpi-tryboot get-primary
#   rpi-tryboot set-primary A|B
#   rpi-tryboot get-state A|B
#   rpi-tryboot set-state A|B good|bad
#   rpi-tryboot get-current
#
# The IronFlockOS Pi disk has boot-a as partition 2 (slot A) and boot-b as
# partition 3 (slot B). autoboot.txt on the FLOCKOS partition (/boot/efi)
# chooses between them:
#
#   [all]       tryboot_a_b=1, boot_partition=<the primary>
#   [tryboot]   boot_partition=<the other>
#
# - set-primary of the other slot arms the firmware's one-shot tryboot flag:
#   the next reboot starts that slot once, from the [tryboot] section.
# - Marking the slot good while it runs from tryboot commits it: the two
#   boot_partition values swap, so it is the primary from then on.
# - A tried slot that does not come up and reboots (kernel panic, watchdog,
#   power cycle) starts the primary again, because the flag is gone. Its
#   state stays "trying", which get-state reports as bad.
#
# Slot states live on /data, beside RAUC's own (good, bad, trying). The
# running slot is always good. The firmware reports the booted partition and
# the tryboot flag in the device tree (/chosen/bootloader); vcmailbox sets
# the flag for the next reboot.
#
# After Rtone's raspberrypi-firmware-rauc-bootloader-backend and Bootlin's
# "Safe updates using RAUC on Raspberry Pi 5"; docs/targets/rpi-arm64.md has
# the differences.
#
# FLOCKOS_AUTOBOOT, FLOCKOS_BOOTLOADER_DT, FLOCKOS_TRYBOOT_STATE and
# FLOCKOS_VCMAILBOX: for the unit tests.
set -euo pipefail
autoboot=${FLOCKOS_AUTOBOOT:-/boot/efi/autoboot.txt}
dt=${FLOCKOS_BOOTLOADER_DT:-/proc/device-tree/chosen/bootloader}
state_file=${FLOCKOS_TRYBOOT_STATE:-/data/rauc/flockos-rpi-tryboot.state}
vcmailbox=${FLOCKOS_VCMAILBOX:-vcmailbox}
# The firmware's "set reboot flags" property; 1 is tryboot.
mailbox_reboot_flags=0x00038064

die() {
  echo "rpi-tryboot: $*" >&2
  exit 1
}

part_of() {
  case "$1" in
    A) echo 2 ;;
    B) echo 3 ;;
    *) die "unknown slot '$1' (A or B)" ;;
  esac
}
slot_of() {
  case "$1" in
    2) echo A ;;
    3) echo B ;;
    *) die "partition '$1' is not a IronFlockOS boot partition (2 or 3)" ;;
  esac
}
other_part() {
  case "$1" in
    2) echo 3 ;;
    3) echo 2 ;;
    *) die "partition '$1' is not a IronFlockOS boot partition (2 or 3)" ;;
  esac
}

# dt_u32 NAME: a 32-bit big-endian cell of the firmware's /chosen/bootloader.
dt_u32() {
  [ -r "$dt/$1" ] || die "$dt/$1 is missing: not started by the Raspberry Pi firmware?"
  od -An -tu4 --endian=big -N4 "$dt/$1" | tr -d ' \n'
}
booted_part() { dt_u32 partition; }
in_tryboot() { [ "$(dt_u32 tryboot)" = 1 ]; }

# primary_part: [all] boot_partition of autoboot.txt.
primary_part() {
  local p
  [ -r "$autoboot" ] || die "$autoboot is missing"
  p=$(awk '/^\[.*\]$/ { all = ($0 == "[all]"); next }
    all && /^boot_partition=/ { sub(/^boot_partition=/, ""); print; exit }' "$autoboot")
  [ -n "$p" ] || die "$autoboot has no boot_partition in [all]"
  other_part "$p" >/dev/null
  echo "$p"
}

# write_autoboot PART: PART the primary, the other partition for tryboot.
# Written next to the old file and renamed over it, so the firmware never
# reads half a file.
write_autoboot() {
  local tmp="$autoboot.new"
  printf '[all]\ntryboot_a_b=1\nboot_partition=%s\n[tryboot]\nboot_partition=%s\n' \
    "$1" "$(other_part "$1")" >"$tmp"
  sync "$tmp" 2>/dev/null || sync
  mv "$tmp" "$autoboot"
  sync "$autoboot" 2>/dev/null || sync
}

# The reboot flag for the next boot.
arm_tryboot() { "$vcmailbox" "$mailbox_reboot_flags" 4 0 1 >/dev/null; }
disarm_tryboot() { "$vcmailbox" "$mailbox_reboot_flags" 4 0 0 >/dev/null; }

state_get() {
  [ -r "$state_file" ] || return 0
  sed -n "s/^$1=//p" "$state_file" | tail -n 1
}
state_set() {
  local tmp="$state_file.new"
  mkdir -p "$(dirname "$state_file")"
  { [ -r "$state_file" ] && grep -v "^$1=" "$state_file" || true; } >"$tmp"
  echo "$1=$2" >>"$tmp"
  mv "$tmp" "$state_file"
}

get_primary() { slot_of "$(primary_part)"; }

get_current() { slot_of "$(booted_part)"; }

set_primary() {
  local want primary
  want=$(part_of "$1")
  primary=$(primary_part)
  if [ "$want" = "$primary" ]; then
    # The primary boots next anyway; drop a tryboot of the other slot.
    disarm_tryboot
  elif [ "$want" = "$(booted_part)" ]; then
    # The slot runs (from tryboot): it is the primary from now on.
    write_autoboot "$want"
  else
    # Try the other slot once at the next reboot.
    write_autoboot "$primary"
    state_set "$1" trying
    arm_tryboot
  fi
}

get_state() {
  local part
  part=$(part_of "$1")
  if [ "$part" = "$(booted_part)" ]; then
    echo good
  elif [ "$(state_get "$1")" = good ]; then
    echo good
  else
    echo bad
  fi
}

set_state() {
  local part booted primary other
  part=$(part_of "$1")
  booted=$(booted_part)
  primary=$(primary_part)
  case "$2" in
    good)
      # Only a slot that runs is vouched for.
      [ "$part" = "$booted" ] || return 0
      state_set "$1" good
      # Running from tryboot: commit it.
      if [ "$part" != "$primary" ] && in_tryboot; then
        write_autoboot "$part"
      fi
      ;;
    bad)
      if [ "$part" = "$primary" ]; then
        # The primary must not stay the next boot: hand it to the other slot
        # (RAUC marks an install's target bad before writing it, which is the
        # primary while the other slot runs from tryboot). Only to a slot
        # known to boot: the firmware has no fallback from a broken
        # [all] boot_partition.
        other=$(other_part "$part")
        if [ "$other" != "$booted" ] && [ "$(state_get "$(slot_of "$other")")" != good ]; then
          die "slot $1 is the only one known to boot; not marking it bad"
        fi
        state_set "$1" bad
        write_autoboot "$other"
      else
        state_set "$1" bad
        disarm_tryboot
      fi
      ;;
    *) die "unknown state '$2' (good or bad)" ;;
  esac
}

[ "$#" -ge 1 ] || die "usage: rpi-tryboot get-primary|set-primary SLOT|get-state SLOT|set-state SLOT STATE|get-current"
cmd=$1
shift
# want_args N USAGE ARG...: exactly N arguments after the command.
want_args() { [ "$#" -eq $(($1 + 2)) ] || die "usage: rpi-tryboot $cmd${2:+ $2}"; }
case "$cmd" in
  get-primary)
    want_args 0 "" "$@"
    get_primary
    ;;
  set-primary)
    want_args 1 SLOT "$@"
    set_primary "$1"
    ;;
  get-state)
    want_args 1 SLOT "$@"
    get_state "$1"
    ;;
  set-state)
    want_args 2 "SLOT good|bad" "$@"
    set_state "$1" "$2"
    ;;
  get-current)
    want_args 0 "" "$@"
    get_current
    ;;
  *) die "unknown command '$cmd'" ;;
esac
