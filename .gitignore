# Build outputs (just build): images, bundles, intermediate filesystems
/out/
*.img
*.img.gz
*.img.xz
*.img.zst
*.raucb
*.ext4
*.vfat
*.log

# Key material never lives in the tree (signing runs in CI against Cloud KMS)
*.pem
*.key
*.p12
# except the public certificates of the RAUC PKI (pki/README.md)
!pki/ironflockos-root-ca.pem
!pki/ironflockos-bundle-signer-*.pem

# Editor and OS noise
.DS_Store
__pycache__/
