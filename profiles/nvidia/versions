# Pinned versions of the nvidia profile (WP-4.1). Plain KEY=value data.

# NVIDIA's CUDA repository for Debian 13 (the driver) and its
# libnvidia-container repository (the container toolkit), both flat
# repositories. Their signing keys are in profiles/nvidia/apt; the unit tests
# check the files against these fingerprints:
# cuda.asc, "Kitmaker (Debian 13 Trixie)"; nvidia-container-toolkit.asc,
# "NVIDIA CORPORATION (Open Source Projects)".
NVIDIA_CUDA_MIRROR=https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64
NVIDIA_CUDA_SIGNER_FINGERPRINT=02182E60104FCDC26EAE1B8597A5D4CB8793F200
NVIDIA_CTK_MIRROR=https://nvidia.github.io/libnvidia-container/stable/deb/amd64
NVIDIA_CTK_SIGNER_FINGERPRINT=C95B321B61E88C1809C4F759DDCAE044F796ECB0

# Driver 615.71.10 (2026-09-24): nvidia-driver-cuda, its libraries and
# firmware-nvidia-gsp at this version, and the open kernel modules built in
# the image from nvidia-kernel-open-dkms at the same version.
NVIDIA_DRIVER_VERSION=615.71.10-1
# NVIDIA Container Toolkit 1.20.1 (2026-09-19).
NVIDIA_CONTAINER_TOOLKIT_VERSION=1.20.1-1
