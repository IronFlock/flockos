# nvidia-persistenced runs once the nvidia module is loaded, which udev does
# only for an NVIDIA GPU (the module's PCI alias). Without a GPU it stays
# inert; it is not started at boot (10-flockos-nvidia.preset). The same
# pattern as nvidia-cdi-refresh (99-nvidia-cdi-refresh.rules).
ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia", TAG+="systemd", ENV{SYSTEMD_WANTS}+="nvidia-persistenced.service"
