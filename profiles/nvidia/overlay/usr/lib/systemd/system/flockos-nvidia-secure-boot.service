# Says why an NVIDIA GPU stays unused under Secure Boot (ADR-0011): the open
# kernel modules are built with the image and signed by no key the machine
# trusts, so a kernel booted with Secure Boot on (locked down) refuses them.
# udev wants this unit for every NVIDIA display controller
# (71-flockos-nvidia.rules), after its attempt to load the module; it runs
# only when Secure Boot is on and the module is not loaded. The message goes
# to the console and the journal; the unit does not fail, so the system
# state and the device-agent's health gate stay as they are.
[Unit]
Description=FlockOS: the NVIDIA driver cannot load under Secure Boot
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/adr/0011-secure-boot-with-debians-signed-boot-chain.md
ConditionSecurity=uefi-secureboot
ConditionPathExists=!/sys/module/nvidia

[Service]
Type=oneshot
StandardOutput=journal+console
SyslogLevel=warning
ExecStart=/usr/bin/echo "FlockOS: Secure Boot is on, and this machine does not trust the NVIDIA driver's kernel modules: the GPU cannot be used. Turn Secure Boot off in the firmware setup to use it."
