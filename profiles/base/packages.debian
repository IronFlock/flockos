# The base packages a Debian image adds (DISTRO_ID=debian): systemd-repart,
# which Ubuntu 24.04 ships in systemd itself, and Debian's firmware packages
# for the kernel to load (lane 1; Ubuntu's linux-firmware, Jetson's
# nvidia-l4t-firmware).
systemd-repart
firmware-linux-free
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-mediatek

# AppArmor's tools and its unit that loads the profiles (ADR-0020). Debian's
# kernels have AppArmor on; with the tools Docker confines every container
# that is not privileged with its docker-default profile, and the profiles
# that Debian's packages bring come into force: chrony's, which the image
# extends in /etc/apparmor.d/local/usr.sbin.chronyd. The Raspberry Pi's kernel
# decides for itself whether AppArmor is on; with it off the package does
# nothing. Not on Jetson (Ubuntu and NVIDIA's kernel) until it is tried there.
apparmor
