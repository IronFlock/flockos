#!/bin/bash
# Real-time tuning of an -rt image (master plan, section 3.11; WP-4b.1).
#
# /etc/ironflockos/rt.conf (-> /data/ironflockos/rt.conf, set by the platform), KEY=value:
#   isolate=<cpus>     CPUs for real-time work: isolcpus, nohz_full, rcu_nocbs
#   irq=<cpus>         CPUs that take interrupts (irqaffinity)
#   cstates=limit|on   limit deep C-states (default limit)
#   thp=never|madvise|always   transparent huge pages (default never)
#   governor=<name>    cpufreq governor (default performance)
# <cpus> is a kernel CPU list such as 2-3 or 1,3,5-7.
#
# Kernel parameters go into IRONFLOCKOS_RT_CMDLINE in grubenv, which GRUB adds on
# both slots, so the tuning survives an A/B update; a change applies at the
# next boot (and /run/ironflockos/rt-reboot-required says so). THP and the
# governor apply at once.
set -euo pipefail

# IRONFLOCKOS_RT_CONF, IRONFLOCKOS_GRUBENV, IRONFLOCKOS_SYS, IRONFLOCKOS_RUN, IRONFLOCKOS_ARCH: for
# the unit tests only.
conf=${IRONFLOCKOS_RT_CONF:-/etc/ironflockos/rt.conf}
grubenv=${IRONFLOCKOS_GRUBENV:-/boot/efi/EFI/BOOT/grubenv}
sys=${IRONFLOCKOS_SYS:-/sys}
run=${IRONFLOCKOS_RUN:-/run/ironflockos}
arch=${IRONFLOCKOS_ARCH:-$(dpkg --print-architecture 2>/dev/null || uname -m)}

isolate="" irq="" cstates=limit thp=never governor=performance
if [ -f "$conf" ]; then
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    case "$line" in '' | '#'*) continue ;; esac
    if [[ ! "$line" =~ ^([a-z]+)=([A-Za-z0-9,-]*)$ ]]; then
      echo "rt-tuning: $conf:$n: not a key=value line" >&2
      exit 1
    fi
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    case "$key" in
      isolate | irq)
        [ -z "$value" ] || [[ "$value" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || {
          echo "rt-tuning: $conf:$n: $key must be a CPU list (2-3, 1,3,5-7)" >&2
          exit 1
        }
        if [ "$key" = isolate ]; then isolate=$value; else irq=$value; fi
        ;;
      cstates)
        [[ "$value" =~ ^(limit|on)$ ]] || {
          echo "rt-tuning: $conf:$n: cstates must be limit or on" >&2
          exit 1
        }
        cstates=$value
        ;;
      thp)
        [[ "$value" =~ ^(never|madvise|always)$ ]] || {
          echo "rt-tuning: $conf:$n: thp must be never, madvise or always" >&2
          exit 1
        }
        thp=$value
        ;;
      governor)
        [[ "$value" =~ ^[a-z]+$ ]] || {
          echo "rt-tuning: $conf:$n: governor must be a name" >&2
          exit 1
        }
        governor=$value
        ;;
      *)
        echo "rt-tuning: $conf:$n: unknown key $key" >&2
        exit 1
        ;;
    esac
  done <"$conf"
fi

params=(nosoftlockup)
if [ -n "$isolate" ]; then
  params+=("isolcpus=managed_irq,domain,$isolate" "nohz_full=$isolate" "rcu_nocbs=$isolate")
fi
[ -n "$irq" ] && params+=("irqaffinity=$irq")
if [ "$cstates" = limit ]; then
  params+=(processor.max_cstate=1)
  case "$arch" in amd64 | x86_64) params+=(intel_idle.max_cstate=0) ;; esac
fi
want="${params[*]}"

have=$({ grub-editenv "$grubenv" list 2>/dev/null || true; } | sed -n 's/^IRONFLOCKOS_RT_CMDLINE=//p')
mkdir -p "$run"
if [ "$have" != "$want" ]; then
  grub-editenv "$grubenv" set "IRONFLOCKOS_RT_CMDLINE=$want"
  echo "rt-tuning: kernel parameters changed, they apply at the next boot: $want"
  : >"$run/rt-reboot-required"
else
  rm -f "$run/rt-reboot-required"
fi

if [ -w "$sys/kernel/mm/transparent_hugepage/enabled" ]; then
  echo "$thp" >"$sys/kernel/mm/transparent_hugepage/enabled"
fi
for g in "$sys"/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do
  [ -w "$g" ] && echo "$governor" >"$g" 2>/dev/null || true
done
echo "rt-tuning: ${want} (thp $thp, governor $governor)"
