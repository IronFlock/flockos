# systemd applies presets on the first boot of every slot (machine-id
# "uninitialized") and enables what no preset names. build/customize.sh
# enables these in the image already; they are named here on purpose, so a
# slot's first boot keeps them on. On the installer stick they are masked,
# which no preset undoes. flockos-proxy-reload.service has no [Install]
# section: flockos-proxy.path starts it.
#
# The site's proxy and NTP servers, from /etc/flockos/proxy.conf and the
# FLOCKOS partition (docs/build.md, "Proxy").
enable flockos-proxy.service
enable flockos-proxy.path
# Network profiles from the FLOCKOS partition, and their trial (docs/build.md,
# "Network profiles").
enable flockos-network-profiles.service
enable flockos-network-profiles-trial.service
# Says when /apps is not /data/apps (docs/build.md, "Disk layout on a device").
enable flockos-apps-check.service
