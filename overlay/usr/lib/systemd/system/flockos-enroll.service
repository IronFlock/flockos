# Enrolls the slot: on its first boot (no /var/lib/flockos/enrolled in this
# slot) and whenever a .flock lies on the FLOCKOS partition. No network
# needed; NetworkManager must run for the WiFi profile.
[Unit]
Description=FlockOS: enroll the device from its .flock
Documentation=https://github.com/IronFlock/flockos/blob/main/docs/master-plan.md
After=docker.service NetworkManager.service boot-efi.mount local-fs.target
Wants=NetworkManager.service
ConditionPathExists=|!/var/lib/flockos/enrolled
ConditionPathExistsGlob=|/boot/efi/*.flock

[Service]
Type=oneshot
ExecStart=/usr/lib/flockos/enroll
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
