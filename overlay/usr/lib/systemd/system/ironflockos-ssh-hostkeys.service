[Unit]
Description=IronFlockOS: SSH host keys on /data
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/master-plan.md
After=local-fs.target ironflockos-data-layout.service
Before=ssh.service
ConditionPathExists=|!/data/etc/ssh/ssh_host_ed25519_key
ConditionPathExists=|!/data/etc/ssh/ssh_host_ecdsa_key
ConditionPathExists=|!/data/etc/ssh/ssh_host_rsa_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A -f /data

[Install]
WantedBy=ssh.service
