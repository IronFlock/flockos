# PTP on the interface in ptp.conf (docs/build.md, "Time"): as a client it
# keeps the interface's hardware clock on the master's time, as a server it is
# the master there. Only when ptp.conf names an interface: flockos-ptp writes
# the configuration.
[Unit]
Description=IronFlockOS: PTP on the network (ptp4l)
Documentation=man:ptp4l(8) https://github.com/IronFlock/ironflockos/blob/main/docs/build.md
ConditionPathExists=/run/flockos/ptp/ptp4l.conf
After=flockos-ptp.service

[Service]
ExecStart=/usr/sbin/ptp4l -f /run/flockos/ptp/ptp4l.conf
# The interface may come late (a USB adapter), or not have hardware time
# stamps; the journal says which.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
