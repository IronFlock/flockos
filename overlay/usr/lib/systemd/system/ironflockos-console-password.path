# Applies a new console password, or locks it again when the file goes, as
# soon as the device-agent has written it.
[Unit]
Description=IronFlockOS: watch /data/ironflockos/console-password

[Path]
PathChanged=/data/ironflockos/console-password
Unit=ironflockos-console-password.service

[Install]
WantedBy=multi-user.target
