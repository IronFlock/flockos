[Unit]
Description=IronFlockOS: directories on /data
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/master-plan.md
DefaultDependencies=no
Requires=data.mount
After=data.mount
Before=local-fs.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/flockos/data-layout
