[Unit]
Description=IronFlockOS: shim where fwupd looks for it
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/adr/0011-secure-boot-with-debians-signed-boot-chain.md
RequiresMountsFor=/boot/efi
ConditionPathIsDirectory=/boot/efi/EFI/debian

[Service]
Type=oneshot
ExecStart=/usr/lib/flockos/fwupd-shim

[Install]
WantedBy=multi-user.target
