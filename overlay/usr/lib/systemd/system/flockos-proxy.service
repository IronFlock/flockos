[Unit]
Description=IronFlockOS: proxy and NTP servers from /etc/flockos/proxy.conf
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/build.md
# /data, the FLOCKOS partition and the agent's .flock copy on /opt/ironflock.
After=local-fs.target flockos-data-layout.service
RequiresMountsFor=/data /boot/efi /opt/ironflock
# Everything that reads /run/flockos/proxy.env or the NTP servers, at its
# start. Not after flockos-enroll, which runs after Docker: on a first boot
# the .flock is still on the FLOCKOS partition, where this reads it.
Before=containerd.service docker.service ironflock-device-agent.service chrony.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/flockos/proxy

[Install]
WantedBy=multi-user.target
Also=flockos-proxy.path
