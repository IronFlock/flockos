[Unit]
Description=IronFlockOS: PTP settings from /etc/flockos/ptp.conf
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/build.md
After=local-fs.target flockos-data-layout.service
# chrony reads the PTP source at its start.
Before=chrony.service flockos-ptp4l.service flockos-phc2sys.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/flockos/ptp

[Install]
WantedBy=multi-user.target
Also=flockos-ptp.path
