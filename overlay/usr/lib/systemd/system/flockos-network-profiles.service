# Network profiles from the FLOCKOS partition (ADR-0016, docs/build.md
# "Network profiles"): NetworkManager keyfiles there, network/*.nmconnection,
# become the device's profiles on /data before NetworkManager starts, on the
# first boot and on every boot where one lies there. A factory reset runs
# before /data is mounted, so before this, and says in
# /run/flockos/factory-reset-hold whether the profiles wait (ADR-0015).
[Unit]
Description=IronFlockOS: network profiles from the FLOCKOS partition
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/adr/0016-network-profiles-from-the-flockos-partition.md
# /data with its folders, or flockos-data-missing's note that there is none
# (nofail mounts, all before local-fs.target): /data is not required, so a
# device without it still gets its profiles, into the slot's own folder.
After=local-fs.target flockos-data-layout.service flockos-data-missing.service
RequiresMountsFor=/boot/efi
Before=NetworkManager.service
ConditionPathExistsGlob=/boot/efi/network/*.nmconnection

[Service]
Type=oneshot
ExecStart=/usr/lib/flockos/network-profiles
# NetworkManager waits for it. A profile takes well under a second, and each
# leaves the partition once it is on /data: what a run cut short by the limit
# did not take is taken at the next boot (ADR-0016).
TimeoutStartSec=2min
# A refused profile on the screen and the serial console too: a device
# without its network is reached there.
StandardError=journal+console

[Install]
WantedBy=multi-user.target
