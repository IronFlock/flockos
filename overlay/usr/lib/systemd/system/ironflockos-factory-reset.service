# Factory reset (ADR-0015, docs/build.md "Factory reset"): runs when the
# IRONFLOCKOS partition holds factory-reset.conf, or a reset that has begun left
# factory-reset.keep there, before /data and everything that uses it. /data's
# mount wants it (data.mount.wants/), so it has no [Install] and no preset
# touches it; nothing requires it, so a reset that fails or runs out of time
# never stops the boot. The script itself always lets the boot go on; it
# restarts the device only after a completed reset. On a boot without a
# request the conditions skip it, and so they do when a unit that needs /data
# is started later.
[Unit]
Description=IronFlockOS: factory reset, when the IRONFLOCKOS partition asks for one
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/adr/0015-factory-reset-requested-on-the-ironflockos-partition.md
DefaultDependencies=no
ConditionPathExists=|/boot/efi/factory-reset.conf
ConditionPathExists=|/boot/efi/factory-reset.keep
ConditionPathIsMountPoint=!/data
Wants=boot-efi.mount
After=boot-efi.mount systemd-remount-fs.service systemd-repart.service dev-disk-by\x2dpartlabel-data.device
# Before /data is checked and mounted, and before anything that reads the
# settings on it: Docker, containerd and the agent come after local-fs.target.
Before=systemd-fsck@dev-disk-by\x2dpartlabel-data.service data.mount local-fs.target
Before=ironflockos-data-layout.service ironflockos-proxy.service ironflockos-ca.service ironflockos-ptp.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/ironflockos/factory-reset
# The steps on the screen and the serial console: the journal of a boot that
# completes a reset is lost with its restart.
StandardOutput=journal+console
StandardError=journal+console
# The script limits an attempt to 25 minutes and the steps after it; this is
# the last net for a disk that blocks even those.
TimeoutStartSec=60min
