# phc2sys for the role in ptp.conf (docs/build.md, "Time"):
# client: the PTP time of ptp4l's hardware clock to chrony's PTP source, while
# ptp4l follows a master (-a); chrony falls back to NTP when the samples stop.
# server: the system clock, which chrony keeps on NTP, to the hardware clock
# that ptp4l serves.
[Unit]
Description=IronFlockOS: PTP time between the hardware clock and the system clock (phc2sys)
Documentation=man:phc2sys(8) https://github.com/IronFlock/ironflockos/blob/main/docs/build.md
ConditionPathExists=/run/ironflockos/ptp/phc2sys.env
After=ironflockos-ptp.service ironflockos-ptp4l.service chrony.service
# A client's phc2sys connects to chrony's socket once, at its start.
PartOf=chrony.service

[Service]
ExecStart=/usr/lib/ironflockos/ptp phc2sys
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
