[Unit]
Description=IronFlockOS: the console password of the enrolled user
Documentation=https://github.com/IronFlock/ironflockos/blob/main/docs/build.md
# After enroll, which makes the user again in a slot an update brought; the
# login prompts wait for this (getty@.service.d).
After=local-fs.target data.mount ironflockos-enroll.service

[Service]
# Not RemainAfterExit: ironflockos-console-password.path starts it again.
Type=oneshot
ExecStart=/usr/lib/ironflockos/console-password

[Install]
WantedBy=multi-user.target
Also=ironflockos-console-password.path
