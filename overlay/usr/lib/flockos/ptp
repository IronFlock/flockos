#!/bin/bash
# PTP on a device (docs/build.md, "Time").
#
# /etc/flockos/ptp.conf (-> /data/flockos/ptp.conf, a device setting), KEY=value
# lines; # starts a comment, also after a value:
#   interface=<name>          the network interface for PTP; without it PTP is off
#   role=client|server        client (default): take the time from the PTP master
#                             on the interface; server: be the PTP master there
#   domain=<0-255>            PTP domain (default 0)
#   transport=udp4|udp6|l2    PTP over UDP/IPv4, UDP/IPv6 or Ethernet (default udp4)
#   delay=e2e|p2p             delay mechanism (default e2e)
#   priority1=<0-255>         role=server: the priority it announces (default 64;
#                             lower wins against the 128 clocks ship with)
#
# client: ptp4l keeps the interface's hardware clock on the master's time, as a
# client only; phc2sys hands that time to chrony while ptp4l follows a master.
# chrony prefers it over its NTP sources, which stay as the fallback.
# server: ptp4l is the master on the interface and never takes time from it;
# phc2sys keeps the interface's hardware clock on the system clock, which
# chrony keeps on NTP.
#
# Without an argument (flockos-ptp.service, at boot before chrony) it writes
# ptp4l's configuration, phc2sys's settings and chrony's PTP source to
# /run/flockos; the units start on them. "apply" (flockos-ptp-reload.service,
# when the file changes) also restarts what the change concerns. "phc2sys"
# (flockos-phc2sys.service) runs phc2sys for the role.
set -euo pipefail

# FLOCKOS_PTP_CONF, FLOCKOS_RUN: for the unit tests only.
conf=${FLOCKOS_PTP_CONF:-/etc/flockos/ptp.conf}
run=${FLOCKOS_RUN:-/run/flockos}

ptp4l_conf=$run/ptp/ptp4l.conf
phc2sys_env=$run/ptp/phc2sys.env
chrony_conf=$run/chrony/ptp.conf

if [ "${1:-}" = phc2sys ]; then
  role="" domain="" interface=""
  while IFS='=' read -r key value; do
    case "$key" in
      PTP_ROLE) role=$value ;;
      PTP_DOMAIN) domain=$value ;;
      PTP_INTERFACE) interface=$value ;;
    esac
  done <"$phc2sys_env"
  common=(-n "$domain" -l 5 -m -q)
  case "$role" in
    client)
      # The flags linuxptp's timemaster gives phc2sys for chrony: samples to
      # chrony's socket, only while ptp4l follows a master (-a).
      exec phc2sys -a -r -R 1 -E refclock_sock --refclock_sock_address /run/chrony/ptp.sock "${common[@]}"
      ;;
    server)
      # The clients follow the hardware clock, so it starts from the system
      # clock once chrony has set it (up to 2 minutes; without NTP, as it is).
      if ! chronyc waitsync 12 0.01 >/dev/null 2>&1; then
        echo "ptp: chrony has not synchronised the clock; serving the clock as it is"
      fi
      exec phc2sys -s CLOCK_REALTIME -c "$interface" -w "${common[@]}"
      ;;
    *)
      echo "ptp: $phc2sys_env names no role" >&2
      exit 1
      ;;
  esac
fi

interface="" role=client domain=0 transport=udp4 delay=e2e priority1=64
if [ -f "$conf" ]; then
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    # Blank lines and comments, also after a value, as in docs/build.md.
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ ! "$line" =~ ^[[:space:]]*([a-z0-9]+)=([A-Za-z0-9._:-]*)[[:space:]]*(#.*)?$ ]]; then
      echo "ptp: $conf:$n: not a key=value line" >&2
      exit 1
    fi
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    case "$key" in
      interface)
        # A kernel interface name: at most 15 characters, no slash or space.
        [ -z "$value" ] || [[ "$value" =~ ^[A-Za-z0-9._:-]{1,15}$ ]] || {
          echo "ptp: $conf:$n: interface must be a network interface name (enp88s0)" >&2
          exit 1
        }
        interface=$value
        ;;
      role)
        [[ "$value" =~ ^(client|server)$ ]] || {
          echo "ptp: $conf:$n: role must be client or server" >&2
          exit 1
        }
        role=$value
        ;;
      domain | priority1)
        [[ "$value" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$value))" -le 255 ] || {
          echo "ptp: $conf:$n: $key must be a number from 0 to 255" >&2
          exit 1
        }
        if [ "$key" = domain ]; then domain=$((10#$value)); else priority1=$((10#$value)); fi
        ;;
      transport)
        [[ "$value" =~ ^(udp4|udp6|l2)$ ]] || {
          echo "ptp: $conf:$n: transport must be udp4, udp6 or l2" >&2
          exit 1
        }
        transport=$value
        ;;
      delay)
        [[ "$value" =~ ^(e2e|p2p)$ ]] || {
          echo "ptp: $conf:$n: delay must be e2e or p2p" >&2
          exit 1
        }
        delay=$value
        ;;
      *)
        echo "ptp: $conf:$n: unknown key $key" >&2
        exit 1
        ;;
    esac
  done <"$conf"
fi

# Writes $2 to $1 unless it says that already; prints "changed" if it wrote.
put() {
  if [ ! -f "$1" ] || [ "$(cat "$1")" != "$2" ]; then
    printf '%s\n' "$2" >"$1.new"
    mv "$1.new" "$1"
    echo changed
  fi
}

# Removes $1 if it is there; prints "changed" if it was.
drop() {
  if [ -e "$1" ]; then
    rm -f "$1"
    echo changed
  fi
}

mkdir -p "$run/ptp" "$run/chrony"
ptp_changed="" chrony_changed=""
if [ -n "$interface" ]; then
  case "$transport" in udp4) nt=UDPv4 ;; udp6) nt=UDPv6 ;; l2) nt=L2 ;; esac
  case "$delay" in e2e) dm=E2E ;; p2p) dm=P2P ;; esac
  if [ "$role" = server ]; then
    role_settings="serverOnly 1
priority1 $priority1"
  else
    role_settings="clientOnly 1"
  fi
  ptp_changed+=$(put "$ptp4l_conf" "# Written by /usr/lib/flockos/ptp from $conf.
[global]
$role_settings
domainNumber $domain
network_transport $nt
delay_mechanism $dm
time_stamping hardware
logging_level 5
verbose 1
use_syslog 0

[$interface]")
  ptp_changed+=$(put "$phc2sys_env" "PTP_ROLE=$role
PTP_DOMAIN=$domain
PTP_INTERFACE=$interface")
  if [ "$role" = client ]; then
    # The settings linuxptp's timemaster gives chrony for a PTP source:
    # phc2sys sends one sample a second, chrony takes four per poll of 4 s.
    chrony_changed+=$(put "$chrony_conf" "# Written by /usr/lib/flockos/ptp from $conf: PTP on $interface, domain $domain.
refclock SOCK /run/chrony/ptp.sock refid PTP poll 2 filter 4 precision 1e-9 delay 1e-4")
  else
    chrony_changed+=$(drop "$chrony_conf")
  fi
  extra=""
  [ "$role" = server ] && extra=", priority1 $priority1"
  echo "ptp: $role on $interface, domain $domain, $transport, $delay$extra"
else
  ptp_changed+=$(drop "$ptp4l_conf")
  ptp_changed+=$(drop "$phc2sys_env")
  chrony_changed+=$(drop "$chrony_conf")
  echo "ptp: off (no interface in $conf)"
fi

[ "${1:-}" = apply ] || exit 0
# chrony reads its PTP source at start. phc2sys, as a client, connects to
# chrony's socket at its own start and follows chrony (PartOf=chrony.service).
if [ -n "$interface" ]; then
  units=()
  [ -n "$chrony_changed" ] && units+=(chrony.service)
  [ -n "$ptp_changed$chrony_changed" ] && units+=(flockos-ptp4l.service flockos-phc2sys.service)
  [ ${#units[@]} -eq 0 ] || systemctl restart "${units[@]}"
else
  [ -z "$ptp_changed" ] || systemctl stop flockos-phc2sys.service flockos-ptp4l.service
  [ -z "$chrony_changed" ] || systemctl try-restart chrony.service
fi
