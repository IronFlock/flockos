#!/bin/bash
# The .flock of a FlockOS VM on Compute Engine (ADR-0010). A VM has no
# FLOCKOS partition anyone could put a .flock on: the virtual-device-manager
# puts it into the instance metadata (attribute flockos-flock) when it creates
# the VM. On the first boot of a slot, before flockos-enroll, this writes it to
# the FLOCKOS partition, where enroll takes it as any other .flock and shreds
# it. Then it reports through the guest attribute flockos/flock that the VM has
# it, and the manager removes the attribute from the metadata again: the
# device's secret stays where every process of the VM could read it only until
# the device holds it.
#
# Without the attribute (a VM whose manager has removed it, after an A/B
# update) there is nothing to do: enroll uses the agent's copy on /data.
# flockos-gce-flock.service runs this on Compute Engine only.
set -euo pipefail

# FLOCKOS_METADATA, FLOCKOS_ESP, FLOCKOS_GCE_TRIES, FLOCKOS_GCE_DELAY: for the
# unit tests only.
metadata=${FLOCKOS_METADATA:-http://169.254.169.254/computeMetadata/v1}
esp=${FLOCKOS_ESP:-/boot/efi}
tries=${FLOCKOS_GCE_TRIES:-60}
delay=${FLOCKOS_GCE_DELAY:-2}

flock=$esp/compute-engine.flock
# A dot file until it is checked: enroll takes *.flock only.
part=$esp/.compute-engine.flock.part
trap 'rm -f "$part"' EXIT
umask 077

# The metadata server answers once DHCP has given the VM its address; the unit
# waits for no network target, so it retries here (about two minutes).
code=000
for ((i = 1; i <= tries; i++)); do
  code=$(curl -sS --connect-timeout 2 --max-time 10 -H 'Metadata-Flavor: Google' \
    -o "$part" -w '%{http_code}' "$metadata/instance/attributes/flockos-flock" 2>/dev/null) || code=000
  case "$code" in 200 | 404) break ;; esac
  if [ "$i" -lt "$tries" ]; then sleep "$delay"; fi
done

case "$code" in
  404)
    echo "gce-flock: no .flock in the instance metadata"
    exit 0
    ;;
  200) ;;
  *)
    echo "gce-flock: the metadata server did not answer (last status $code)" >&2
    exit 1
    ;;
esac

if ! jq -e 'type == "object" and has("device_key") and has("secret")' "$part" >/dev/null 2>&1; then
  echo "gce-flock: the attribute flockos-flock of the instance metadata is no .flock" >&2
  exit 1
fi
mv -f "$part" "$flock"
sync -f "$flock"
echo "gce-flock: the .flock from the instance metadata is on the FLOCKOS partition"

# The manager enables guest attributes on its VMs; without them (a VM made by
# hand) the attribute stays in the metadata, and that is all.
if ! curl -fsS --connect-timeout 2 --max-time 10 -X PUT --data taken -H 'Metadata-Flavor: Google' \
  "$metadata/instance/guest-attributes/flockos/flock" >/dev/null 2>&1; then
  echo "gce-flock: no guest attributes on this VM: flockos-flock stays in its metadata" >&2
fi
