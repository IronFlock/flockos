#!/bin/sh
# Whether the apps' data is on /data (docs/build.md, "Disk layout on a
# device"): /apps, the device-agent's -appsDir, is bound from /data/apps, so it
# outlives updates. The mount is nofail (/etc/fstab): when it fails, the boot,
# Docker and the agent go on, on the slot's own /apps, whose content an update
# replaces. This runs after the mount and before Docker and the agent, and
# then says so on the console and in the journal, leaves
# /run/ironflockos/apps-not-persistent for `ironflock status`, and fails, so
# `systemctl --failed` shows it. It changes nothing else.
set -eu
# IRONFLOCKOS_APPS, IRONFLOCKOS_DATA, IRONFLOCKOS_RUN: for the unit tests only.
apps=${IRONFLOCKOS_APPS:-/apps}
data=${IRONFLOCKOS_DATA:-/data}
run=${IRONFLOCKOS_RUN:-/run/ironflockos}
mark=$run/apps-not-persistent

# ident PATH: device and inode, the same for a folder and its bind mount.
ident() { stat -L -c '%d:%i' "$1" 2>/dev/null || stat -L -f '%d:%i' "$1" 2>/dev/null || echo "none:$1"; }

if [ -e "$run/data-missing" ]; then
  # No /data at all: ironflockos-data-missing has said so, and that Docker and
  # the apps do not run; this adds nothing to it.
  rm -f "$mark"
  echo "apps-check: /data is missing (see $run/data-missing): Docker and the apps do not run"
  exit 0
fi
if [ -d "$apps" ] && [ -d "$data/apps" ] && [ "$(ident "$apps")" = "$(ident "$data/apps")" ]; then
  rm -f "$mark"
  echo "apps-check: /apps is /data/apps"
  exit 0
fi
msg="apps-check: /apps is not /data/apps: the apps run, but their data is lost at the next OS update (see journalctl -b -u apps.mount)"
echo "$msg" >&2
mkdir -p "$run"
echo "$msg" >"$mark"
exit 1
