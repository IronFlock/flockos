#!/bin/bash
# Factory reset of an IronFlockOS device (docs/build.md, "Factory reset";
# ADR-0015).
#
# The request is the file factory-reset.conf on the IRONFLOCKOS partition
# (/boot/efi), KEY=value lines; # starts a comment, also after a value:
#   keep-network=yes|no   keep the network profiles, proxy.conf and ptp.conf
#                         (default no)
# An empty file asks for a reset that keeps no network settings. A file with
# anything else (another key or value, a line that is not KEY=value, a NUL
# byte) is refused: nothing is cleared, the file is renamed to
# factory-reset.conf.refused, and the device boots as before.
#
# A device must always come online, so no failure of the reset stops a boot.
# Without an argument (ironflockos-factory-reset.service, which /data's mount
# wants), at boot before /data is mounted:
#   - An attempt is counted before it starts, in factory-reset.state of the
#     booted slot (/var/lib/ironflockos). A request has three attempts.
#   - An attempt ("attempt", the same script under a time limit): RAUC's state
#     and, with keep-network=yes, the network settings go into
#     factory-reset.keep on the IRONFLOCKOS partition; once that file has its name
#     the reset has begun. The root slots are cleared (clean_slot), then the
#     data partition gets a new filesystem and the kept files are put back.
#   - A completed reset is marked done in the state and on the new /data
#     (ironflockos/factory-reset.done), so it is never done twice; it is recorded
#     in factory-reset.log (on the IRONFLOCKOS partition and next to the state),
#     its files are removed, and the device restarts into a first boot. That
#     is the only restart the reset makes.
#   - A failed attempt is recorded, and the boot goes on with what /data
#     holds; the next boot tries again. After the third failure the reset
#     gives up: a /data it had begun to erase gets a new filesystem, the record
#     says what of the old owner is left, and the boot goes on.
# /run/ironflockos/factory-reset-hold tells enroll and ironflockos-proxy what to do
# with the IRONFLOCKOS partition's .flock and proxy.conf meanwhile: "wait" while
# the old owner's data may still be on /data (the old identity runs), "copy"
# once it is being erased (take them, and leave them there for the reset that
# is still to come).
#
# "check FILE" prints keep-network=yes or keep-network=no for a request this
# device accepts (exit 0), or the reason it refuses it on stderr (exit 1), and
# changes nothing.
set -euo pipefail
# The request is parsed and the record written alike in every locale.
export LC_ALL=C

# IRONFLOCKOS_ESP, IRONFLOCKOS_ROOT, IRONFLOCKOS_SYSTEM_CONF, IRONFLOCKOS_PROC_CMDLINE,
# IRONFLOCKOS_DATA_DEV, IRONFLOCKOS_RUN, IRONFLOCKOS_BOOTLOADER_DT, IRONFLOCKOS_RESET_WAIT,
# IRONFLOCKOS_RESET_LIMIT: for the unit tests only.
esp=${IRONFLOCKOS_ESP:-/boot/efi}
root=${IRONFLOCKOS_ROOT:-}
system_conf=${IRONFLOCKOS_SYSTEM_CONF:-/etc/rauc/system.conf}
cmdline=${IRONFLOCKOS_PROC_CMDLINE:-/proc/cmdline}
data_dev=${IRONFLOCKOS_DATA_DEV:-/dev/disk/by-partlabel/data}
run=${IRONFLOCKOS_RUN:-/run/ironflockos}
dt=${IRONFLOCKOS_BOOTLOADER_DT:-/proc/device-tree/chosen/bootloader}
wait_secs=${IRONFLOCKOS_RESET_WAIT:-30}

scratch=$run/factory-reset
hold_file=$run/factory-reset-hold
result_file=$scratch/result
request=$esp/factory-reset.conf
record=$esp/factory-reset.log
keep=$esp/factory-reset.keep
keep_part=$esp/.factory-reset.keep.part
state_file=$root/var/lib/ironflockos/factory-reset.state
record_copy=$root/var/lib/ironflockos/factory-reset.log
attempts_max=3
# Time limits in seconds: a whole attempt, and the steps that wait on a disk.
# Running into one is a failed attempt; the unit's own limit is the last net.
limit_attempt=${IRONFLOCKOS_RESET_LIMIT:-1500}
limit_mount=120
limit_mkfs=900
limit_copy=300
limit_slot=600
limit_short=60
# The hostname of a flashed image (overlay/etc/hostname).
image_hostname=ironflockos
# What is kept of /data: RAUC's state always, the network on request.
keep_always="rauc"
keep_network_items="network/connections ironflockos/proxy.conf ironflockos/ptp.conf"
# Folders below /data, and in the root slots, are never followed through a
# symbolic link that the old owner may have put there.
mount_opts=nodev,nosuid,nosymfollow

say() { echo "factory-reset: $*"; }

# lim SECONDS COMMAND...: COMMAND, stopped when it runs longer.
lim() {
  local secs=$1
  shift
  timeout -k 10 "$secs" "$@"
}

# parse FILE: sets keep_network, or sets reason and fails. The reason names
# no file: `ironflock os reset` shows it for its own temporary file.
parse() {
  keep_network=no reason=""
  local n=0 line key value seen=""
  if [ -L "$1" ] || [ ! -f "$1" ]; then
    reason="the request is not a file"
    return 1
  fi
  if [ "$(wc -c <"$1")" -gt 4096 ]; then
    reason="the request is larger than 4 KiB"
    return 1
  fi
  # read drops NUL bytes; a file a power loss left with zeros is no request.
  if [ "$(tr -d '\000' <"$1" | wc -c)" -ne "$(wc -c <"$1")" ]; then
    reason="the request holds a NUL byte"
    return 1
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    # The byte order mark some editors write.
    [ "$n" -gt 1 ] || line=${line#$'\xef\xbb\xbf'}
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ ! "$line" =~ ^[[:space:]]*([A-Za-z0-9_-]+)[[:space:]]*=[[:space:]]*(\"?)([^\"[:space:]#]*)(\"?)[[:space:]]*(#.*)?$ ]] ||
      [ "${BASH_REMATCH[2]}" != "${BASH_REMATCH[4]}" ]; then
      reason="line $n is not a key=value line"
      return 1
    fi
    key=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')
    value=$(printf '%s' "${BASH_REMATCH[3]}" | tr '[:upper:]' '[:lower:]')
    case "$key" in
      keep-network)
        if [[ ! "$value" =~ ^(yes|no)$ ]]; then
          reason="line $n: keep-network must be yes or no"
          return 1
        fi
        if [ -n "$seen" ] && [ "$seen" != "$value" ]; then
          reason="line $n: keep-network is given twice, with different values"
          return 1
        fi
        seen=$value keep_network=$value
        ;;
      *)
        reason="line $n: unknown key $key"
        return 1
        ;;
    esac
  done <"$1"
}

# request_id FILE: tells a request from another one with the same content:
# its checksum, size and time of change.
request_id() {
  local sum stamp
  sum=$(cksum <"$1" 2>/dev/null | awk '{ print $1 "-" $2 }' || true)
  stamp=$(date -u -r "$1" +%Y%m%dT%H%M%SZ 2>/dev/null || true)
  echo "${sum:-unreadable}-${stamp:-unknown}"
}

# os_release KEY: a value of the booted slot's os-release.
os_release() {
  sed -n "s/^$1=//p" "$root/usr/lib/os-release" 2>/dev/null | tr -d '"' | head -n 1 || true
}

# write_record RESULT [KEY=VALUE...]: factory-reset.log on the IRONFLOCKOS
# partition and its copy in the booted slot, beside the state. Nothing of the
# device's owner goes into it. Fails when neither could be written.
write_record() {
  local result=$1 text ok=1
  shift
  text=$(
    echo "# IronFlockOS factory reset (docs/build.md, \"Factory reset\")"
    echo "result=$result"
    echo "time=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "image=$(os_release IMAGE_ID)"
    echo "version=$(os_release IMAGE_VERSION)"
    echo "slot=${slot:-unknown}"
    echo "request=${id:-}"
    if [ "$#" -gt 0 ]; then printf '%s\n' "$@"; fi
  )
  if put_file "$record" "$text"; then ok=0; else say "could not write $record"; fi
  if put_file "$record_copy" "$text"; then ok=0; else say "could not write $record_copy"; fi
  return "$ok"
}

# put_file FILE TEXT: FILE holds TEXT, written to a new file, synced and
# renamed.
put_file() {
  mkdir -p "$(dirname "$1")" 2>/dev/null &&
    printf '%s\n' "$2" >"$1.part" 2>/dev/null &&
    lim "$limit_short" sync &&
    mv -f "$1.part" "$1" 2>/dev/null &&
    lim "$limit_short" sync
}

# state_get KEY: a value of the attempt state of this slot.
state_get() {
  sed -n "s/^$1=//p" "$state_file" 2>/dev/null | head -n 1 || true
}

# state_set KEY=VALUE...: the state with these values, written durably and
# read back; fails when it cannot be.
state_set() {
  local kv text
  text=$(cat "$state_file" 2>/dev/null || true)
  for kv in "$@"; do
    text=$(printf '%s\n' "$text" | grep -v "^${kv%%=*}=" || true)
    text+=$'\n'$kv
  done
  put_file "$state_file" "$(printf '%s\n' "$text" | sed '/^$/d' | LC_ALL=C sort)" || return 1
  for kv in "$@"; do
    [ "$(state_get "${kv%%=*}")" = "${kv#*=}" ] || return 1
  done
}

# hold wait|copy|gave-up|none: what enroll and ironflockos-proxy do with the
# IRONFLOCKOS partition's .flock and proxy.conf at this boot. wait: a reset is
# open and the old owner's data may be on /data, leave them; copy: a reset is
# open and has begun to erase, take them and leave them there; gave-up: a
# reset gave up with the old data and could not remove the files that came
# for the device after it, leave them; none (no file): take them as usual.
hold() {
  mkdir -p "$run" 2>/dev/null || true
  if [ "$1" = none ]; then
    rm -f "$hold_file"
  else
    printf '%s\n' "$1" >"$hold_file" || say "could not write $hold_file"
  fi
}

# remove FILE: overwritten first where that is possible, then removed.
remove() {
  lim "$limit_short" shred -u "$1" 2>/dev/null || rm -f "$1"
}

# remove_files: factory-reset.keep and every .factory-reset*.part of the
# IRONFLOCKOS partition (a requester's temporary files and the reset's). Fails
# when one stays.
remove_files() {
  local f bad=0
  for f in "$keep" "$esp"/.factory-reset*.part; do
    if [ -e "$f" ]; then remove "$f" 2>/dev/null || bad=1; fi
  done
  return "$bad"
}

# conf_value SECTION KEY: a value of RAUC's system.conf.
conf_value() {
  awk -v want="[$1]" -v key="$2" '
    /^[ \t]*\[/ { section = $0; gsub(/[ \t]/, "", section); next }
    section == want {
      line = $0; sub(/^[ \t]*/, "", line)
      if (index(line, key) != 1) next
      rest = substr(line, length(key) + 1); sub(/^[ \t]*/, "", rest)
      if (substr(rest, 1, 1) != "=") next
      rest = substr(rest, 2); sub(/^[ \t]*/, "", rest); sub(/[ \t]*$/, "", rest)
      print rest; exit
    }' "$system_conf" 2>/dev/null || true
}

# rootfs_devices: the device of every root slot in system.conf.
rootfs_devices() {
  awk '
    /^[ \t]*\[/ { rootfs = ($0 ~ /^[ \t]*\[slot\.rootfs\.[0-9]+\][ \t]*$/); next }
    rootfs && /^[ \t]*device[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); sub(/[ \t]*$/, ""); print }
  ' "$system_conf" 2>/dev/null || true
}

# root_device: the partition of the booted root slot, by its device number
# (the kernel may call it /dev/root).
root_device() {
  local majmin
  majmin=$(findmnt -nvo MAJ:MIN / 2>/dev/null || true)
  if [ -n "$majmin" ] && [ -e "/dev/block/$majmin" ]; then
    readlink -f "/dev/block/$majmin"
  else
    findmnt -nvo SOURCE / 2>/dev/null || true
  fi
}

# blk COLUMN DEVICE: a column of lsblk for one device; nothing when it is none.
blk() {
  lim "$limit_short" lsblk -ndo "$1" -- "$2" 2>/dev/null | head -n 1 || true
}

# disk_of DEVICE: the disk a partition is on; nothing when it is none.
disk_of() {
  local dev
  dev=$(readlink -f -- "$1" 2>/dev/null) || return 0
  blk PKNAME "$dev"
}

# wait_dev DEVICE SECONDS: whether DEVICE is there, waiting for udev.
wait_dev() {
  local i
  for ((i = 0; i < $2; i++)); do
    if [ -e "$1" ]; then return 0; fi
    sleep 1
  done
  [ -e "$1" ]
}

# in_tryboot: the Raspberry Pi firmware started this system on trial.
in_tryboot() {
  [ -r "$dt/tryboot" ] && [ "$(od -An -tx1 -N4 "$dt/tryboot" | tr -d ' \n')" = 00000001 ]
}

# keep_booted_slot: GRUB counts every boot as a try of its slot until it is
# marked good. A boot that goes on with the reset is not one: a power loss
# must bring back this slot, whose system goes on with the reset, never the
# other slot's, which may not know it. Only a slot with _OK=1 (marked good,
# or installed and not yet tried) is kept; one on its first try gets one more.
# Sets try_cleared when it changed grubenv; fails when it cannot read or write
# it.
keep_booted_slot() {
  local env
  [ -n "$grubenv" ] && [ -n "$slot" ] || return 0
  env=$(lim "$limit_short" grub-editenv "$grubenv" list) || return 1
  if grep -qx "${slot}_OK=1" <<<"$env" && ! grep -qx "${slot}_TRY=0" <<<"$env"; then
    lim "$limit_short" grub-editenv "$grubenv" set "${slot}_TRY=0" || return 1
    try_cleared=yes
  fi
}

# rewrite FILE AWK-ARGUMENTS...: FILE through awk, replaced only when that
# changes it, with its mode and owner. Fails without changing FILE.
rewrite() {
  local f=$1
  shift
  [ -f "$f" ] || return 0
  if ! cp -p "$f" "$f.ironflockos-new" || ! awk "$@" "$f" >"$f.ironflockos-new"; then
    rm -f "$f.ironflockos-new"
    return 1
  fi
  if cmp -s "$f" "$f.ironflockos-new"; then
    rm -f "$f.ironflockos-new"
  else
    mv -f "$f.ironflockos-new" "$f"
  fi
}

# replace FILE LINE: FILE holds LINE, written to a new file and renamed.
replace() {
  if [ -f "$1" ] && [ "$(cat "$1")" = "$2" ]; then return 0; fi
  if [ -f "$1" ]; then cp -p "$1" "$1.ironflockos-new" || return 1; fi
  if ! printf '%s\n' "$2" >"$1.ironflockos-new"; then
    rm -f "$1.ironflockos-new"
    return 1
  fi
  mv -f "$1.ironflockos-new" "$1"
}

# Drops the lines whose first field is in "drop", and the names in "strip"
# from the member lists in "fields" (passwd, shadow, group, gshadow, subuid).
# shellcheck disable=SC2016 # an awk program
accounts_awk='
  function set(list, s,   n, i, a) { n = split(list, a, " "); for (i = 1; i <= n; i++) s[a[i]] = 1 }
  function clean(members,   n, i, a, out) {
    n = split(members, a, ","); out = ""
    for (i = 1; i <= n; i++) if (!(a[i] in stripped)) out = out (out == "" ? "" : ",") a[i]
    return out
  }
  BEGIN { FS = OFS = ":"; set(drop, dropped); set(strip, stripped); nf = split(fields, f, " ") }
  $1 in dropped { next }
  { for (i = 1; i <= nf; i++) if (f[i] + 0 <= NF) $(f[i]) = clean($(f[i])); print }'

# remove_accounts ROOT: the accounts of people, uid and gid 1000 to 59999, also
# from the backups shadow-utils keeps (passwd- and the others). The image has
# none (build/customize.sh); the enrollment makes the .flock's SSH user with a
# group of its own.
remove_accounts() {
  local r=$1 users user_groups f bad=0
  users=$(cat "$r/etc/passwd" "$r/etc/passwd-" 2>/dev/null | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | sort -u | tr '\n' ' ' || true)
  user_groups=$(cat "$r/etc/group" "$r/etc/group-" 2>/dev/null | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | sort -u | tr '\n' ' ' || true)
  [ -n "${users// /}${user_groups// /}" ] || return 0
  for f in passwd passwd- shadow shadow- subuid subuid- subgid subgid-; do
    rewrite "$r/etc/$f" -v drop="$users" -v strip="" -v fields="" "$accounts_awk" || bad=1
  done
  for f in group group-; do
    rewrite "$r/etc/$f" -v drop="$user_groups" -v strip="$users" -v fields="4" "$accounts_awk" || bad=1
  done
  for f in gshadow gshadow-; do
    rewrite "$r/etc/$f" -v drop="$user_groups" -v strip="$users" -v fields="3 4" "$accounts_awk" || bad=1
  done
  return "$bad"
}

# clean_slot ROOT booted|other: what the enrollment, the device-agent, apps and
# the device's users leave in a root slot mounted at ROOT ("" is the booted
# one). The system itself, and whether it has proven itself (slot-proven),
# stay. Every part is done that can be; fails when one could not. The
# deletions come first: they make room in a slot that apps have filled. The
# booted slot's machine-id is left to the end of a completed reset: the
# running system needs a valid one until it restarts.
clean_slot() {
  local r=$1 d bad=0
  # Apps' files (the agent's -appsDir), containerd's state, NetworkManager's
  # leases and secret key, sudo's records of the users, temporary files and
  # root's home.
  rm -rf "$r/apps" || bad=1
  for d in var/lib/containerd var/lib/NetworkManager var/lib/sudo/lectured var/tmp root; do
    if [ -d "$r/$d" ]; then
      find "$r/$d" -mindepth 1 -maxdepth 1 -exec rm -rf {} + || bad=1
    fi
  done
  # The enrollment: the sudo rule, the agent's unit, the mark that the slot is
  # enrolled.
  rm -f "$r"/etc/sudoers.d/ironflock-* || bad=1
  rm -rf "$r/etc/systemd/system/ironflock-device-agent.service" \
    "$r/etc/systemd/system/ironflock-device-agent.service.d" "$r/etc/systemd/system/ironflock.slice" \
    "$r"/etc/systemd/system/*.wants/ironflock-device-agent.service || bad=1
  rm -f "$r/var/lib/ironflockos/enrolled" || bad=1
  # Then what is written anew: root's skeleton, the .flock's SSH user, the
  # hostname, and in a slot that does not run a new machine-id at its next
  # boot, as on a first boot.
  for d in bashrc profile; do
    if [ -d "$r/root" ] && [ -f "$r/usr/share/base-files/dot.$d" ]; then
      cp "$r/usr/share/base-files/dot.$d" "$r/root/.$d" || bad=1
    fi
  done
  remove_accounts "$r" || bad=1
  replace "$r/etc/hostname" "$image_hostname" || bad=1
  # shellcheck disable=SC2016 # an awk program
  rewrite "$r/etc/hosts" -v name="$image_hostname" '$1 == "127.0.1.1" { print "127.0.1.1\t" name; next } { print }' || bad=1
  if [ "$2" = other ]; then
    printf 'uninitialized\n' >"$r/etc/machine-id" || bad=1
  fi
  return "$bad"
}

# clean_other_slots: clean_slot on the root slots that are not booted; sets
# other_slot to what happened, for the record, and fails when one was not
# cleaned for an error.
clean_other_slots() {
  local dev root_real booted="" others=() result mnt=$scratch/slot bad=0 rc
  other_slot=""
  root_real=$(readlink -f -- "$rootdev" 2>/dev/null || true)
  while IFS= read -r dev; do
    [ -n "$dev" ] || continue
    if [ "$(readlink -f -- "$dev" 2>/dev/null || true)" = "$root_real" ]; then
      booted=$dev
    else
      others+=("$dev")
    fi
  done < <(rootfs_devices)
  if [ -z "$booted" ]; then
    other_slot="not cleaned (the booted slot is none of system.conf)"
    say "the other slot: $other_slot"
    return 0
  fi
  for dev in "${others[@]}"; do
    dev=$(readlink -f -- "$dev" 2>/dev/null || echo "$dev")
    if ! wait_dev "$dev" "$((wait_secs < 10 ? wait_secs : 10))"; then
      result="none (no partition)"
    elif [ "$(disk_of "$dev")" != "$root_disk" ]; then
      result="not cleaned (on another disk)"
    elif ! mkdir -p "$mnt" || ! lim "$limit_mount" mount -t ext4 -o "$mount_opts" "$dev" "$mnt" 2>/dev/null; then
      if [ -z "$(lim "$limit_short" blkid -p -s TYPE -o value "$dev" 2>/dev/null || true)" ]; then
        # Slot B before the first update.
        result="none (no filesystem)"
      else
        # An installation that broke off, or a filesystem this kernel cannot read.
        result="not cleaned (cannot mount)" bad=1
      fi
    else
      if ! grep -qx 'ID=ironflockos' "$mnt/usr/lib/os-release" 2>/dev/null; then
        result="not cleaned (no IronFlockOS)"
      else
        rc=0
        lim "$limit_slot" "$BASH" "$0" clean-slot "$mnt" other || rc=$?
        if [ "$rc" -eq 0 ]; then result=cleaned; else result="not cleaned (error)" bad=1; fi
      fi
      lim "$limit_short" sync || true
      if ! lim "$limit_mount" umount "$mnt"; then
        say "could not unmount $dev"
        bad=1
      fi
    fi
    rmdir "$mnt" 2>/dev/null || true
    say "the other slot ($dev): $result"
    other_slot+=${other_slot:+, }$result
  done
  [ -n "$other_slot" ] || other_slot=none
  return "$bad"
}

# report KEY=VALUE...: the attempt's results for the supervisor.
report() {
  printf '%s\n' "$@" >>"$result_file"
}

# --- an attempt ---------------------------------------------------------------
# Runs as "attempt" under the supervisor's time limit, with what the
# supervisor found in FR_* variables. Exit 0: the new /data is there (the
# result file says what else failed); 3: it failed before the reset had
# begun, nothing was cleared; 4: it failed after.

# fail MESSAGE: an attempt that cannot go on.
fail() {
  local m
  trap - EXIT
  for m in old new slot; do
    if [ -d "$scratch/$m" ]; then lim "$limit_mount" umount "$scratch/$m" 2>/dev/null || true; fi
  done
  report "reason=$1"
  say "$1"
  if [ "$begun" = yes ]; then exit 4; fi
  if [ "$try_cleared" = yes ]; then
    lim "$limit_short" grub-editenv "$grubenv" set "${slot}_TRY=1" || true
  fi
  if [ -e "$keep_part" ]; then remove "$keep_part" 2>/dev/null || true; fi
  exit 3
}

# on_exit: a command that failed under set -e before the new filesystem.
# shellcheck disable=SC2329 # the EXIT trap of an attempt
on_exit() {
  local rc=$?
  [ "$rc" -eq 0 ] || fail "stopped while $step (exit $rc)"
}

# step_failed NAME: a step after the new filesystem that did not succeed.
step_failed() {
  say "the step $1 failed; the reset goes on"
  case " $failed_steps " in *" $1 "*) ;; *) failed_steps+=${failed_steps:+ }$1 ;; esac
}

attempt() {
  local item items names=() notes=() note="" kept="" meta stage old new rc
  export IRONFLOCKOS_ATTEMPT_PID=$$
  begun=$FR_BEGUN keep_network=$FR_KEEP_NETWORK try_cleared=no failed_steps=""
  data=$FR_DATA root_disk=$FR_ROOT_DISK rootdev=$FR_ROOTDEV
  step="checking the disk"
  trap on_exit EXIT
  if [ -z "$data" ] || [ ! -e "$data" ]; then fail "the data partition ($data_dev) is missing"; fi
  if [ -z "$root_disk" ]; then fail "the disk of the root slot (${rootdev:-unknown}) is unknown"; fi
  if [ "$(blk PARTLABEL "$data")" != data ] || [ "$(disk_of "$data")" != "$root_disk" ]; then
    fail "the data partition is not the partition named data on the disk of the root slot"
  fi
  # Only the IRONFLOCKOS partition of the disk the system runs from can ask.
  if [ "$(disk_of "$(findmnt -nvo SOURCE "$esp" 2>/dev/null || true)")" != "$root_disk" ]; then
    fail "the IRONFLOCKOS partition at $esp is not on the disk of the root slot"
  fi

  if [ "$begun" = no ]; then
    step="keeping RAUC's state and the settings to keep"
    stage=$scratch/keep old=$scratch/old
    # A mount point is only ever removed with rmdir, never with what is in it.
    rm -rf "$stage"
    mkdir -p "$stage" "$old"
    items=$keep_always
    if [ "$keep_network" = yes ]; then items+=" $keep_network_items"; fi
    if lim "$limit_mount" mount -t ext4 -o "ro,noexec,$mount_opts" "$data" "$old" 2>/dev/null; then
      for item in $items; do
        if [ -e "$old/$item" ]; then
          mkdir -p "$stage/$(dirname "$item")"
          if lim "$limit_copy" cp -a "$old/$item" "$stage/$item" 2>/dev/null; then
            kept+=${kept:+ }$item
          else
            rm -rf "${stage:?}/$item"
            notes+=("$item could not be read and was not kept")
            say "$item could not be read and was not kept"
          fi
        fi
      done
      lim "$limit_mount" umount "$old" || fail "cannot unmount the data partition"
    elif [ "$FR_ATTEMPT" -lt "$attempts_max" ]; then
      # Perhaps only for now: the next attempt may still keep its files.
      fail "the data partition could not be mounted to keep its files"
    else
      notes+=("the data partition could not be mounted: nothing of it was kept")
      say "the data partition could not be mounted: nothing of it was kept"
    fi
    if [ "${#notes[@]}" -gt 0 ]; then note=$(printf '%s; ' "${notes[@]}") && note=${note%; }; fi
    printf 'request=%s\nkeep-network=%s\nkept=%s\nnote=%s\n' "$FR_ID" "$keep_network" "$kept" "$note" >"$stage/.factory-reset"
    names=(.factory-reset)
    for item in $kept; do
      case " ${names[*]} " in *" ${item%%/*} "*) ;; *) names+=("${item%%/*}") ;; esac
    done
    # Readable by root only; the IRONFLOCKOS partition is anyway (/etc/fstab).
    (umask 077 && lim "$limit_copy" tar -C "$stage" --numeric-owner -cpf "$keep_part" "${names[@]}") ||
      fail "cannot write factory-reset.keep to the IRONFLOCKOS partition"
    lim "$limit_copy" tar -tf "$keep_part" >/dev/null || fail "cannot read back factory-reset.keep"
    lim "$limit_short" sync || fail "the IRONFLOCKOS partition does not answer"
    step="keeping the booted slot for the next boot"
    keep_booted_slot || fail "cannot read or write $grubenv"
    mv -f "$keep_part" "$keep"
    # From here on the reset goes on at every boot until it is done or gives up.
    begun=yes
    report begun=yes
    lim "$limit_short" sync || true
    rm -rf "$stage" || true
    rmdir "$old" 2>/dev/null || true
  elif ! keep_booted_slot; then
    step_failed grubenv
  fi

  # The root slots first: an attempt that fails at the data partition leaves
  # no account, app file or agent unit of the old owner beside a new one.
  step="clearing the root slots"
  say "clearing the booted slot"
  rc=0
  lim "$limit_slot" "$BASH" "$0" clean-slot "$root" booted || rc=$?
  if [ "$rc" -eq 0 ]; then
    state_set booted-slot=cleaned || true
  else
    step_failed booted-slot
  fi
  rc=0
  clean_other_slots || rc=$?
  report "other-slot=$other_slot"
  if [ "$rc" -eq 0 ]; then
    state_set other-slot=cleaned || true
  else
    step_failed other-slot
  fi

  step="making a new filesystem on the data partition"
  # Recorded before it starts: an attempt cut short from here on has erased
  # the old /data, or part of it, and the IRONFLOCKOS partition's .flock may be
  # used before the next attempt (hold copy).
  state_set erase=started || fail "cannot record in $state_file that the erase begins"
  hold copy
  say "$step"
  lim "$limit_mkfs" mkfs.ext4 -F -q -L data -m 0 "$data" || fail "mkfs.ext4 failed on $data, or did not end"
  new=$scratch/new
  mkdir -p "$new"
  lim "$limit_mount" mount -t ext4 -o "$mount_opts" "$data" "$new" || fail "cannot mount the new filesystem"

  # The new /data is there. Whatever fails from here on is named in the
  # record, and the reset completes all the same.
  trap - EXIT
  set +e
  if meta=$(lim "$limit_copy" tar -xOf "$keep" .factory-reset 2>/dev/null) &&
    lim "$limit_copy" tar -C "$new" --numeric-owner -xpf "$keep"; then
    kept=$(sed -n 's/^kept=//p' <<<"$meta")
    note=$(sed -n 's/^note=//p' <<<"$meta")
  else
    kept="" note="factory-reset.keep could not be read: nothing of the data partition was kept"
    step_failed restore
  fi
  rm -f "$new/.factory-reset"
  say "kept: ${kept:-nothing}"

  if [ -n "$grubenv" ]; then
    # The platform's real-time tuning goes with rt.conf: the next boot runs
    # the image's defaults, as a flashed device does.
    if env=$(lim "$limit_short" grub-editenv "$grubenv" list); then
      if grep -q '^IRONFLOCKOS_RT_CMDLINE=' <<<"$env"; then
        lim "$limit_short" grub-editenv "$grubenv" unset IRONFLOCKOS_RT_CMDLINE || step_failed grubenv
      fi
    else
      step_failed grubenv
    fi
  fi
  # The mark that this request is done, with what the record says of it: for
  # either slot, a lost state, and a record lost to a power loss.
  if ! printf '%s\n' "request=$FR_ID" "outcome=done" "slot=$slot" "attempt=$FR_ATTEMPT" "keep-network=$keep_network" "kept=$kept" \
    "other-slot=$other_slot" "note=$note" "failed-steps=$failed_steps" >"$new/ironflockos-reset.done"; then
    step_failed restore
  fi
  if ! mkdir -p "$new/ironflockos" || ! mv -f "$new/ironflockos-reset.done" "$new/ironflockos/factory-reset.done"; then
    step_failed restore
  fi
  lim "$limit_short" sync
  lim "$limit_mount" umount "$new" || step_failed restore
  rmdir "$new" 2>/dev/null
  report "kept=$kept" "note=$note" "failed-steps=$failed_steps"
  exit 0
}

# --- the supervisor -----------------------------------------------------------

# result_get KEY: a value the attempt reported.
result_get() {
  sed -n "s/^$1=//p" "$result_file" 2>/dev/null | tail -n 1 || true
}

# data_mounts: the data partition holds a filesystem that mounts (read only,
# under the time limit).
data_mounts() {
  local check=$scratch/check ok=1
  [ -n "$data" ] && [ -e "$data" ] || return 1
  mkdir -p "$check"
  if lim "$limit_mount" mount -t ext4 -o "ro,noexec,$mount_opts" "$data" "$check" 2>/dev/null; then
    ok=0
    lim "$limit_mount" umount "$check" 2>/dev/null || true
  fi
  rmdir "$check" 2>/dev/null || true
  return "$ok"
}

# done_on_data: the data partition carries the mark that this request is done
# (a reset completed in the other slot, or one whose state was lost); sets
# done_mark to its content.
done_on_data() {
  local check=$scratch/check found=1
  done_mark=""
  [ -n "$data" ] && [ -e "$data" ] || return 1
  mkdir -p "$check"
  if lim "$limit_mount" mount -t ext4 -o "ro,noexec,$mount_opts" "$data" "$check" 2>/dev/null; then
    if grep -qx "request=$id" "$check/ironflockos/factory-reset.done" 2>/dev/null; then
      done_mark=$(cat "$check/ironflockos/factory-reset.done")
      found=0
    fi
    lim "$limit_mount" umount "$check" 2>/dev/null || true
  fi
  rmdir "$check" 2>/dev/null || true
  return "$found"
}

# mark_data TEXT: the mark of how this request ended, on the data partition,
# for either slot and a lost state. Best effort, under its time limits.
mark_data() {
  local dir=$scratch/mark ok=1
  [ -n "$data" ] && [ -e "$data" ] || return 1
  mkdir -p "$dir"
  if lim "$limit_mount" mount -t ext4 -o "$mount_opts" "$data" "$dir" 2>/dev/null; then
    if mkdir -p "$dir/ironflockos" && printf '%s\n' "$1" >"$dir/ironflockos/.factory-reset.done.new" &&
      mv -f "$dir/ironflockos/.factory-reset.done.new" "$dir/ironflockos/factory-reset.done"; then
      ok=0
    fi
    lim "$limit_short" sync || true
    lim "$limit_mount" umount "$dir" || ok=1
  fi
  rmdir "$dir" 2>/dev/null || true
  return "$ok"
}

# retire OLD-DATA: a request that gave up triggers no more: renamed to
# factory-reset.conf.gave-up. With the old owner's data still on /data the
# .flock and proxy.conf that came for the device after the reset go too: the
# device stays the device it was. Sets the hold: gave-up while they could not
# be removed (a read-only IRONFLOCKOS partition), none otherwise.
retire() {
  local f left=no
  if [ -e "$request" ]; then
    rm -rf "$request.gave-up" 2>/dev/null || true
    mv -f "$request" "$request.gave-up" 2>/dev/null || say "could not rename $request: the slot's state and the mark on /data keep it from being tried again"
  fi
  if [ "$1" = yes ]; then
    for f in "$esp"/*.flock "$esp/proxy.conf"; do
      if [ -e "$f" ]; then remove "$f" 2>/dev/null || left=yes; fi
    done
  fi
  if [ "$left" = yes ]; then hold gave-up; else hold none; fi
}

# mark_get KEY: a value of the done mark.
mark_get() {
  sed -n "s/^$1=//p" <<<"$done_mark" | head -n 1 || true
}

# record_done [FAILED-STEP...]: the record of a completed reset, from its mark
# on /data.
record_done() {
  local failed lines=() s
  failed=$(mark_get failed-steps)
  for s in "$@"; do failed+=${failed:+ }$s; done
  lines+=("attempt=$(mark_get attempt)" "attempts-max=$attempts_max" "keep-network=$(mark_get keep-network)")
  lines+=("kept=$(mark_get kept)" "other-slot=$(mark_get other-slot)")
  if [ -n "$(mark_get note)" ]; then lines+=("note=$(mark_get note)"); fi
  if [ -n "$failed" ]; then
    write_record incomplete "${lines[@]}" "failed-steps=$failed" || true
  else
    write_record "done" "${lines[@]}" || true
  fi
}

# fresh_data: a new filesystem with the kept files, for a /data that was
# being erased when the reset gave up. Fails when it cannot be made.
fresh_data() {
  local new=$scratch/new ok=1
  [ -n "$data" ] && [ -e "$data" ] || return 1
  lim "$limit_mkfs" mkfs.ext4 -F -q -L data -m 0 "$data" || return 1
  mkdir -p "$new"
  if lim "$limit_mount" mount -t ext4 -o "$mount_opts" "$data" "$new" 2>/dev/null; then
    ok=0
    if [ -e "$keep" ]; then
      lim "$limit_copy" tar -C "$new" --numeric-owner -xpf "$keep" 2>/dev/null || say "the kept files could not be put back"
      rm -f "$new/.factory-reset"
    fi
    lim "$limit_short" sync || true
    lim "$limit_mount" umount "$new" || true
  fi
  rmdir "$new" 2>/dev/null || true
  return "$ok"
}

# finished: this request's reset was completed before; its files stay because
# a power loss came first, or they could not be removed. They go now if they
# can, the record is written if it is missing, and nothing else happens.
finished() {
  say "the reset of this request was completed before; it is not done again"
  hold none
  remove_files || true
  if ! grep -qx "request=$id" "$record" 2>/dev/null && ! grep -qx "request=$id" "$record_copy" 2>/dev/null; then
    if [ -z "$done_mark" ] && [ -e "$data_dev" ]; then
      data=$(readlink -f -- "$data_dev")
      done_on_data || true
    fi
    if [ -n "$done_mark" ]; then record_done; fi
  fi
  rm -f "$request" 2>/dev/null || say "could not remove $request: it is ignored at every boot"
  exit 0
}

# give_up REASON: no more attempts. The device boots with what /data holds; a
# /data that was being erased gets a new filesystem first.
give_up() {
  local reason=$1 erase data_left="" left=""
  erase=$(state_get erase)
  state_set outcome=gave-up || say "could not write $state_file"
  if [ "$erase" = started ]; then
    if fresh_data; then
      data_left=new
    else
      # What the old owner had there may not all be overwritten.
      data_left=none left=data
      say "THE DATA PARTITION HOLDS NO FILESYSTEM THAT MOUNTS: the device runs without /data (ironflockos-data-missing)"
    fi
  else
    data_left=old
    left=data
  fi
  if [ "$(state_get booted-slot)" != cleaned ]; then left+=${left:+ }booted-slot; fi
  if [ "$(state_get other-slot)" != cleaned ]; then left+=${left:+ }other-slot; fi
  if [ "$data_left" != none ]; then
    mark_data "$(printf '%s\n' "request=$id" "outcome=gave-up" "erase=${erase:-no}")" ||
      say "could not leave the mark on /data that this request gave up"
  fi
  remove_files || say "could not remove factory-reset.keep or a part file"
  say "GAVE UP after $attempts_max attempts ($reason); the device boots with /data as it is ($data_left)${left:+; left of the old owner: $left}"
  write_record gave-up "attempt=$attempt" "attempts-max=$attempts_max" "reason=$reason" "keep-network=$keep_network" \
    "data=$data_left" "left=$left" || true
  # The old owner's data is still on /data: the device stays the device it
  # was, and a new identity must not land on that data.
  if [ "$data_left" = old ]; then retire yes; else retire no; fi
  exit 0
}

# gave_up_before ERASE: this request gave up at an earlier boot, perhaps in
# the other slot. Nothing is tried; what could not be retired then is now.
gave_up_before() {
  say "this request was given up before (factory-reset.log); it is not tried again"
  state_set request="$id" outcome=gave-up erase="$1" || true
  if [ "$1" = started ]; then retire no; else retire yes; fi
  exit 0
}

# completed: the attempt made the new /data, and done_mark says what else
# happened. The booted slot gets its new machine-id at the restart, the files
# go, the request last, and the device restarts into its first boot. It runs
# again at the next boot when a power loss cut it short.
completed() {
  local extra=()
  printf 'uninitialized\n' >"$root/etc/machine-id" || extra+=(booted-slot)
  if ! remove_files; then extra+=(keep-file); fi
  record_done "${extra[@]}"
  if ! state_set outcome=done; then say "could not write $state_file; the mark on /data keeps the reset from being done again"; fi
  local failed
  failed=$(mark_get failed-steps)${extra[*]:+ ${extra[*]}}
  if ! rm -f "$request" 2>/dev/null; then
    say "could not remove $request: it is ignored from now on, as this reset is done"
  fi
  hold none
  lim "$limit_short" sync || true
  say "${failed:+incomplete ($failed), }done; restarting into a first boot"
  if ! systemctl --no-block reboot; then
    # This boot goes on: it needs a valid machine-id, a new one.
    tr -d '-' </proc/sys/kernel/random/uuid >"$root/etc/machine-id" 2>/dev/null || true
    say "could not restart; restart the device to complete the reset"
  fi
  exit 0
}

case "${1:-}" in
  check)
    if [ "$#" -ne 2 ]; then
      echo "usage: factory-reset check FILE" >&2
      exit 2
    fi
    if parse "$2"; then
      echo "keep-network=$keep_network"
      exit 0
    fi
    echo "factory-reset: $reason" >&2
    exit 1
    ;;
  attempt)
    slot=$FR_SLOT grubenv=$FR_GRUBENV
    attempt
    ;;
  clean-slot)
    [ "$#" -eq 3 ] || exit 2
    clean_slot "$2" "$3"
    exit $?
    ;;
  "") ;;
  *)
    echo "usage: factory-reset [check FILE]" >&2
    exit 2
    ;;
esac

umask 022
mkdir -p "$scratch"
done_mark=""
slot=$(tr ' ' '\n' <"$cmdline" 2>/dev/null | sed -n 's/^rauc\.slot=//p' | head -n 1 || true)
grubenv=""
if [ "$(conf_value system bootloader)" = grub ]; then grubenv=$(conf_value system grubenv); fi
if [ -e "$keep" ]; then
  # Begun before: what it keeps, and for which request, is in
  # factory-reset.keep, whatever the request says now.
  begun=yes
  meta=$(lim "$limit_copy" tar -xOf "$keep" .factory-reset 2>/dev/null || true)
  keep_network=$(sed -n 's/^keep-network=//p' <<<"$meta")
  keep_network=${keep_network:-unknown}
  id=$(sed -n 's/^request=//p' <<<"$meta")
  [ -n "$id" ] || id=keep-$(request_id "$keep")
elif [ ! -e "$request" ]; then
  say "no request ($request)"
  hold none
  exit 0
elif ! parse "$request"; then
  # Its identity for the record, read before the rename; "unreadable-..."
  # when its content cannot be read.
  id=$(request_id "$request")
  say "refused $request: $reason; nothing was cleared, the device boots as before"
  rm -rf "$request.refused" 2>/dev/null || true
  mv -f "$request" "$request.refused" 2>/dev/null || say "could not rename $request"
  remove_files 2>/dev/null || true
  write_record refused "reason=$reason" || true
  hold none
  exit 0
else
  begun=no
  id=$(request_id "$request")
fi

# The state is this request's: a new request has all its attempts.
same=no
if [ "$(state_get request)" = "$id" ]; then same=yes; fi
attempt=0
if [ "$same" = yes ]; then attempt=$(state_get attempts); fi
[[ "$attempt" =~ ^[0-9]+$ ]] || attempt=0
if [ "$same" = yes ] && [ "$(state_get outcome)" = "done" ]; then finished; fi
if [ "$same" = yes ] && [ "$(state_get outcome)" = gave-up ]; then
  gave_up_before "$(state_get erase)"
fi
if [ "$begun" = no ] && in_tryboot; then
  say "this system runs on trial (tryboot): the reset waits for the next boot that is not a trial"
  hold wait
  exit 0
fi

data=""
if wait_dev "$data_dev" "$wait_secs"; then
  # The device, resolved once: a disk plugged in later cannot take over the link.
  data=$(readlink -f -- "$data_dev")
  if findmnt -rn --source "$data" >/dev/null 2>&1; then
    # Started while the system runs (a unit that needs /data was started):
    # the reset is for a boot.
    say "/data is mounted: the reset runs at the next boot"
    exit 0
  fi
fi
if done_on_data; then
  if [ "$(mark_get outcome)" = gave-up ]; then gave_up_before "$(mark_get erase)"; fi
  if [ "$same" = yes ] && [ "$(mark_get slot)" = "$slot" ]; then
    # This system completed the reset, and a power loss cut its end short.
    attempt=$(mark_get attempt)
    completed
  fi
  state_set request="$id" outcome=done || true
  finished
fi

if [ "$same" = yes ] && [ "$(state_get erase)" = started ]; then erase=started; else erase=no; fi
if [ "$attempt" -ge "$attempts_max" ]; then
  give_up "$(state_get last-failure)"
fi

# An attempt is counted before it starts. Where nothing can be written there
# is no attempt: the device boots as it is, and the old identity runs on.
attempt=$((attempt + 1))
counted=no
if [ "$same" = yes ]; then
  if state_set attempts="$attempt"; then counted=yes; fi
elif state_set request="$id" attempts="$attempt" erase=no booted-slot= other-slot= outcome= last-failure=; then
  counted=yes
fi
if [ "$counted" != yes ]; then
  say "cannot write $state_file: without a count there is no attempt at this boot; the device boots as it is"
  # attempt= is the attempt that was due and not made; /data is as an
  # earlier attempt left it: old before any erase, else new if it mounts.
  data_now=old
  if [ "$erase" = started ]; then
    if data_mounts; then data_now=new; else data_now=none; fi
  fi
  write_record failed "attempt=$attempt" "attempts-max=$attempts_max" "reason=cannot count the attempt in $state_file" \
    "begun=$begun" "data=$data_now" || true
  if [ "$erase" = started ]; then hold copy; else hold wait; fi
  exit 0
fi
if [ "$erase" = started ]; then hold copy; else hold wait; fi
if [ "$begun" = yes ]; then
  say "attempt $attempt of $attempts_max, going on with the reset begun before (keep network: $keep_network)"
else
  say "attempt $attempt of $attempts_max: resetting the device (keep network: $keep_network)"
fi

rootdev=$(root_device)
rm -f "$result_file"
rc=0
FR_ID=$id FR_ATTEMPT=$attempt FR_BEGUN=$begun FR_KEEP_NETWORK=$keep_network FR_DATA=$data FR_ROOTDEV=$rootdev \
  FR_ROOT_DISK=$(disk_of "$rootdev") FR_SLOT=$slot FR_GRUBENV=$grubenv IRONFLOCKOS_RESET_PID=$$ \
  lim "$limit_attempt" "$BASH" "$0" attempt || rc=$?
if [ "$rc" -eq 0 ]; then
  done_mark=$(printf '%s\n' "request=$id" "slot=$slot" "attempt=$attempt" "keep-network=$keep_network" \
    "kept=$(result_get kept)" "other-slot=$(result_get other-slot)" "note=$(result_get note)" \
    "failed-steps=$(result_get failed-steps)")
  completed
fi

case "$rc" in
  124 | 137) reason="the attempt did not end within $limit_attempt seconds" ;;
  3 | 4) reason=$(result_get reason) ;;
  *) reason="the attempt stopped (exit $rc)" ;;
esac
reason=${reason:-the attempt stopped (exit $rc)}
state_set last-failure="$reason" || true
if [ -e "$keep" ]; then begun=yes; fi
if [ "$attempt" -ge "$attempts_max" ]; then give_up "$reason"; fi
# The boot goes on with what /data holds; the next boot tries again. A /data
# that was being erased gets a new filesystem with the kept files, so this
# boot runs on no half-erased one and keeps its network.
erase=$(state_get erase)
data_now=old
if [ "$erase" = started ]; then
  if fresh_data; then data_now=new; else data_now=none; fi
fi
say "attempt $attempt of $attempts_max failed ($reason); the next boot tries again, this one goes on (/data: $data_now)"
write_record failed "attempt=$attempt" "attempts-max=$attempts_max" "reason=$reason" "begun=$begun" "data=$data_now" || true
if [ "$erase" = started ]; then hold copy; else hold wait; fi
exit 0
