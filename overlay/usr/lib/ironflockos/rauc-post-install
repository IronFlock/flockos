#!/bin/sh
# RAUC post-install handler (system.conf [handlers]), for every target slot
# RAUC has just written:
# - a root slot (class rootfs) gets the device's identity, so the new slot
#   boots as the same machine: machine-id keeps the journal and the DHCP
#   client id; hostname is what device-init or the platform set; and a
#   factory reset's state, so a request done or given up stays so; on Jetson
#   its /boot/extlinux/extlinux.conf gets root= and rauc.slot= of that slot
#   (WP-6.2), as the bundle's names slot A;
# - a Raspberry Pi boot partition (class boot, WP-5.2) gets a cmdline.txt
#   that mounts its own root slot: the bundle's names slot A.
set -eu

files="/etc/machine-id /etc/hostname"
reset_state=${IRONFLOCKOS_RESET_STATE:-/var/lib/ironflockos/factory-reset.state}
prefix=${RAUC_MOUNT_PREFIX:-/run/rauc}
cmdline_tool=${IRONFLOCKOS_RPI_CMDLINE:-/usr/lib/ironflockos/rpi-cmdline}
extlinux_tool=${IRONFLOCKOS_TEGRA_EXTLINUX:-/usr/lib/ironflockos/tegra-extlinux}

fail() {
  echo "rauc-post-install: $*" >&2
  exit 1
}

# mount_slot INDEX DEVICE FSTYPE: mounts on $mnt, unmounted on exit.
mount_slot() {
  [ -b "$2" ] || fail "$2 is not a block device"
  mnt="$prefix/ironflockos-post-install-$1"
  mkdir -p "$mnt"
  mount -t "$3" "$2" "$mnt"
  # shellcheck disable=SC2064 # expand now: the mount point of this slot
  trap "umount '$mnt'; rmdir '$mnt'" EXIT
}
unmount_slot() {
  sync -f "$mnt" 2>/dev/null || sync
  umount "$mnt"
  rmdir "$mnt"
  trap - EXIT
}

for i in ${RAUC_TARGET_SLOTS:-}; do
  eval "class=\${RAUC_SLOT_CLASS_$i:-}"
  eval "device=\${RAUC_SLOT_DEVICE_$i:-}"
  # shellcheck disable=SC2154 # assigned by the eval above
  case "$class" in
    rootfs)
      # shellcheck disable=SC2154
      mount_slot "$i" "$device" ext4
      for f in $files; do
        if [ -s "$f" ]; then
          cp -p "$f" "$mnt$f"
        fi
      done
      # A factory reset's state (ADR-0015): a request that was done or given
      # up is not tried again by the new system. Never a reason to fail.
      if [ -s "$reset_state" ]; then
        { mkdir -p "$mnt$(dirname "$reset_state")" && cp -p "$reset_state" "$mnt$reset_state"; } ||
          echo "rauc-post-install: could not carry $reset_state to slot $i" >&2
      fi
      extlinux=""
      if [ -f "$mnt/boot/extlinux/extlinux.conf" ]; then
        eval "bootname=\${RAUC_SLOT_BOOTNAME_$i:-}"
        partuuid=$(blkid -s PARTUUID -o value "$device") || fail "no PARTUUID for $device"
        # shellcheck disable=SC2154 # assigned by the eval above
        "$extlinux_tool" "$mnt/boot/extlinux/extlinux.conf" "$partuuid" "$bootname"
        extlinux=", extlinux.conf mounts slot $bootname (PARTUUID=$partuuid)"
      fi
      unmount_slot
      echo "rauc-post-install: copied machine-id and hostname to slot $i ($device)$extlinux"
      ;;
    boot)
      # The root slot of the group: RAUC_SLOT_PARENT_<i> names it.
      eval "parent=\${RAUC_SLOT_PARENT_$i:-}"
      root_device="" root_bootname=""
      for j in ${RAUC_SLOTS:-}; do
        eval "name=\${RAUC_SLOT_NAME_$j:-}"
        # shellcheck disable=SC2154
        if [ "$name" = "$parent" ]; then
          eval "root_device=\${RAUC_SLOT_DEVICE_$j:-}"
          eval "root_bootname=\${RAUC_SLOT_BOOTNAME_$j:-}"
        fi
      done
      # shellcheck disable=SC2154
      [ -n "$root_device" ] && [ -n "$root_bootname" ] || fail "boot slot $i: no root slot '$parent'"
      [ -b "$root_device" ] || fail "$root_device is not a block device"
      partuuid=$(blkid -s PARTUUID -o value "$root_device") || fail "no PARTUUID for $root_device"
      mount_slot "$i" "$device" vfat
      "$cmdline_tool" "$mnt/cmdline.txt" "$partuuid" "$root_bootname"
      unmount_slot
      echo "rauc-post-install: cmdline.txt of slot $i ($device) mounts slot $root_bootname (PARTUUID=$partuuid)"
      ;;
  esac
done
