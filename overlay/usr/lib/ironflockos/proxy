#!/bin/bash
# The site's proxy and NTP servers (docs/build.md, "Proxy").
#
# /etc/ironflockos/proxy.conf (-> /data/ironflockos/proxy.conf, a device setting),
# KEY=value lines; # starts a comment, also after a value:
#   http_proxy=<url>     proxy for http:// (http://, https://, socks5://, socks5h://)
#   https_proxy=<url>    proxy for https:// (default: http_proxy)
#   no_proxy=<list>      hosts, domains and networks reached directly, comma-separated
#   ntp=<list>           NTP servers, comma-separated, for networks that block NTP
#                        to the internet
# A proxy's user and password go into the URL, percent-encoded.
#
# The proxy reaches the device-agent (its platform connection, downloads,
# tunnels, and the apps it starts), Docker and containerd through
# /run/ironflockos/proxy.env (drop-ins in the image). NO_PROXY always holds
# localhost and, from the device's .flock, the appliance's domain and the LAN
# registries, as the agent's own installer adds them. ntp= goes to chrony as
# extra sources.
#
# Without an argument (ironflockos-proxy.service, at boot before Docker and the
# agent) it first takes a proxy.conf from the IRONFLOCKOS partition, where
# FlockFlasher or the installer puts it: that one replaces the device's and
# leaves the partition. "apply" (ironflockos-proxy-reload.service, when the file
# changes) restarts what the change concerns.
set -euo pipefail

# IRONFLOCKOS_PROXY_CONF, IRONFLOCKOS_ESP, IRONFLOCKOS_RUN, IRONFLOCKOS_AGENT_FLOCK: for the
# unit tests only.
conf=${IRONFLOCKOS_PROXY_CONF:-/data/ironflockos/proxy.conf}
esp=${IRONFLOCKOS_ESP:-/boot/efi}
run=${IRONFLOCKOS_RUN:-/run/ironflockos}
agent_flock=${IRONFLOCKOS_AGENT_FLOCK:-/opt/ironflock/device-agent/device-config.flock}

env_file=$run/proxy.env
sources=$run/chrony-sources/ironflockos.sources

url_re='^(https?|socks5h?)://[][A-Za-z0-9._~:/?@!&()*+,;=%-]+$'
list_re='^[][A-Za-z0-9.,:/*_-]*$'

# parse FILE: sets http_proxy, https_proxy, no_proxy and ntp, or says what is
# wrong and fails.
parse() {
  http_proxy="" https_proxy="" no_proxy="" ntp=""
  local n=0 line key value
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ ! "$line" =~ ^[[:space:]]*([A-Za-z_]+)[[:space:]]*=[[:space:]]*(\"?)([^\"[:space:]#]*)(\"?)[[:space:]]*(#.*)?$ ]] ||
      [ "${BASH_REMATCH[2]}" != "${BASH_REMATCH[4]}" ]; then
      echo "proxy: $1:$n: not a key=value line" >&2
      return 1
    fi
    key=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]') value=${BASH_REMATCH[3]}
    case "$key" in
      http_proxy | https_proxy)
        [ -z "$value" ] || [[ "$value" =~ $url_re ]] || {
          echo "proxy: $1:$n: $key must be a URL such as http://proxy.example:3128 (user and password percent-encoded)" >&2
          return 1
        }
        if [ "$key" = http_proxy ]; then http_proxy=$value; else https_proxy=$value; fi
        ;;
      no_proxy)
        [[ "$value" =~ $list_re ]] || {
          echo "proxy: $1:$n: no_proxy must be a comma-separated list of hosts, domains and networks" >&2
          return 1
        }
        no_proxy=$value
        ;;
      ntp)
        [[ "$value" =~ ^[A-Za-z0-9.:,_-]*$ ]] || {
          echo "proxy: $1:$n: ntp must be a comma-separated list of NTP servers" >&2
          return 1
        }
        ntp=$value
        ;;
      *)
        echo "proxy: $1:$n: unknown key $key" >&2
        return 1
        ;;
    esac
  done <"$1"
  [ -n "$https_proxy" ] || https_proxy=$http_proxy
}

# flock_bypass FILE: the hosts of a .flock the agent's installer keeps off the
# proxy: the appliance's domain (and its subdomains) and the LAN registries
# (insecure-registries, and a docker_registry_url with a port), without port.
flock_bypass() {
  jq -r '
    def host: ascii_downcase | sub("^https?://"; "") | sub("/.*$"; "")
      | if test("^\\[") then capture("^\\[(?<h>[^\\]]+)\\]").h
        elif (split(":") | length) == 2 then sub(":[0-9]+$"; "")
        else . end;
    (.appliance_domain // "" | select(. != "") | ascii_downcase | (., "." + .)),
    (."insecure-registries" // "" | select(. != "")
      | . as $listed | (try fromjson catch $listed) | if type == "array" then .[] else . end
      | tostring | host),
    (.docker_registry_url // "" | ascii_downcase | sub("^https?://"; "") | sub("/.*$"; "")
      | select(test(":[0-9]+$")) | host)
  ' "$1" 2>/dev/null || true
}

# put FILE CONTENT MODE: writes CONTENT unless FILE says that already; prints
# "changed" if it wrote. An empty CONTENT removes FILE.
put() {
  if [ -z "$2" ]; then
    if [ -e "$1" ]; then
      rm -f "$1"
      echo changed
    fi
  elif [ ! -f "$1" ] || [ "$(cat "$1")" != "$2" ]; then
    (umask 077 && printf '%s\n' "$2" >"$1.new")
    chmod "$3" "$1.new"
    mv "$1.new" "$1"
    echo changed
  fi
}

rc=0
# A factory reset (ADR-0015) says in factory-reset-hold what to do with the
# IRONFLOCKOS partition's proxy.conf and .flock meanwhile: "wait" (they are for
# the device after it), or "copy" (take them, and leave them there for the
# reset still to come); "gave-up" as "wait" (a reset gave up with the old
# data and could not remove them). Without /data (ironflockos-data-missing) they
# are copied.
reset_hold=$(cat "$run/factory-reset-hold" 2>/dev/null || true)
if [ "$reset_hold" = gave-up ]; then reset_hold="wait"; fi
if [ "$reset_hold" != wait ] && [ -e "$run/data-missing" ]; then reset_hold=copy; fi
if [ "${1:-}" != apply ] && [ "$reset_hold" != wait ] && [ -f "$esp/proxy.conf" ]; then
  if parse "$esp/proxy.conf"; then
    mkdir -p "$(dirname "$conf")"
    # cp keeps the source's mode under the umask, and a file on the FAT
    # partition shows the execute bits (0700): the mode is set, not inherited.
    (umask 077 && cp "$esp/proxy.conf" "$conf.new")
    chmod 0600 "$conf.new"
    mv "$conf.new" "$conf"
    if [ "$reset_hold" = copy ]; then
      echo "proxy: took proxy.conf from the IRONFLOCKOS partition and left it there, as what the device keeps now does not last"
    else
      # It may hold a password; the IRONFLOCKOS partition is readable by anyone
      # who holds the disk.
      shred -u "$esp/proxy.conf" 2>/dev/null || rm -f "$esp/proxy.conf"
      echo "proxy: took proxy.conf from the IRONFLOCKOS partition"
    fi
  else
    echo "proxy: ignored the IRONFLOCKOS partition's proxy.conf, which has an error; the device keeps its own" >&2
    rc=1
  fi
elif [ "${1:-}" != apply ] && [ -f "$esp/proxy.conf" ]; then
  echo "proxy: a factory reset waits: the IRONFLOCKOS partition's proxy.conf waits for it"
fi

http_proxy="" https_proxy="" no_proxy="" ntp=""
if [ -f "$conf" ]; then
  # A configuration with an error changes nothing: what runs keeps running.
  parse "$conf" || exit 1
fi

env=""
if [ -n "$http_proxy$https_proxy" ]; then
  # The .flock that enroll takes on this boot (the newest, whatever the case
  # of its name), else the agent's copy.
  flock=""
  for f in "$esp"/*.[Ff][Ll][Oo][Cc][Kk]; do
    if [ ! -f "$f" ] || [ "$reset_hold" = wait ]; then continue; fi
    if [ -z "$flock" ] || [ "$f" -nt "$flock" ]; then flock=$f; fi
  done
  [ -n "$flock" ] || flock=$agent_flock
  bypass=""
  while IFS= read -r entry; do
    entry=$(printf '%s' "$entry" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
    [ -n "$entry" ] || continue
    case ",$bypass," in *",$entry,"*) continue ;; esac
    bypass+=${bypass:+,}$entry
  done < <(
    printf '%s\n' localhost 127.0.0.1 ::1
    [ -f "$flock" ] && flock_bypass "$flock"
    printf '%s\n' "$no_proxy" | tr ',' '\n'
  )
  env="HTTP_PROXY=$http_proxy
HTTPS_PROXY=$https_proxy
NO_PROXY=$bypass
http_proxy=$http_proxy
https_proxy=$https_proxy
no_proxy=$bypass"
fi

servers=""
if [ -n "$ntp" ]; then
  servers="# Written by /usr/lib/ironflockos/proxy from /etc/ironflockos/proxy.conf."
  while IFS= read -r server; do
    [ -n "$server" ] && servers+=$'\n'"server $server iburst"
  done < <(printf '%s\n' "$ntp" | tr ',' '\n')
fi

mkdir -p "$run/chrony-sources"
# The proxy URL may hold a password; chronyd reads its sources as _chrony.
env_changed=$(put "$env_file" "$env" 0600)
ntp_changed=$(put "$sources" "$servers" 0644)

if [ -n "$env" ]; then
  shown=$(printf '%s' "$https_proxy" | sed -E 's|//[^/@]*@|//***@|')
  echo "proxy: $shown, not for $bypass"
else
  echo "proxy: none"
fi
[ -z "$ntp" ] || echo "proxy: NTP servers $ntp"

if [ "${1:-}" = apply ]; then
  # Units that do not run stay as they are; running ones read the new
  # environment. Containers get it when the agent next creates them.
  [ -z "$env_changed" ] || systemctl try-restart containerd.service docker.service ironflock-device-agent.service
  [ -z "$ntp_changed" ] || chronyc reload sources >/dev/null 2>&1 || true
fi
exit "$rc"
