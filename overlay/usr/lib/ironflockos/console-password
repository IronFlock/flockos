#!/bin/bash
# The console password of the device (docs/build.md, "The screen";
# docs/kiosk-plan.md, D8).
#
# /data/ironflockos/console-password, owned by root, mode 0600, written by the
# device-agent (set in Studio): one line, a crypt(3) hash, yescrypt ($y$) or
# SHA-512 ($6$). It becomes the password of the device's enrolled user, the
# account `ironflock enroll` made for SSH from the .flock's owner, with its
# sudo rule: a person at the screen logs in on tty2 to tty6 with it. Without
# the file that account's password is locked, as `ironflock enroll` leaves it.
# Root and every other account are never touched; SSH stays key-only
# (sshd_config.d/10-ironflockos.conf).
#
# Runs at every boot after ironflockos-enroll (an A/B update brings a slot
# whose /etc/shadow has no password) and before the login prompts, and again
# whenever the file changes (ironflockos-console-password.path). A file it
# does not take (another owner or mode, not one line, an empty hash or one of
# another kind) is refused: the journal says why, the password stays locked,
# and the unit fails.
#
# The enrolled user is the one in `ironflock`'s record of the enrollment,
# /opt/ironflock/device-init/installed.json (.user.name); it must be an
# account of a person (uid 1000 to 59999) with the sudo rule enroll writes.
set -euo pipefail
export LC_ALL=C

# IRONFLOCKOS_CONSOLE_PASSWORD, IRONFLOCKOS_INIT_RECORD, IRONFLOCKOS_ROOT: for
# the unit tests only.
file=${IRONFLOCKOS_CONSOLE_PASSWORD:-/data/ironflockos/console-password}
record=${IRONFLOCKOS_INIT_RECORD:-/opt/ironflock/device-init/installed.json}
root=${IRONFLOCKOS_ROOT:-}
shadow=$root/etc/shadow

say() { echo "console-password: $*"; }

# set_password USER FIELD: USER's password field in /etc/shadow becomes FIELD,
# written to a new file with the same mode and owner and renamed; nothing
# else changes. Nothing is written when it is FIELD already.
set_password() {
  local new=$shadow.ironflockos-new
  if [ "$(awk -F: -v u="$1" '$1 == u { print $2 }' "$shadow")" = "$2" ]; then
    return 0
  fi
  cp -p "$shadow" "$new"
  if ! awk -F: -v OFS=: -v u="$1" -v p="$2" '$1 == u { $2 = p } { print }' "$shadow" >"$new"; then
    rm -f "$new"
    return 1
  fi
  mv -f "$new" "$shadow"
}

# lock USER: a password field that holds a hash gets "!" in its place; one
# that is locked stays as it is.
lock() {
  local have
  have=$(awk -F: -v u="$1" '$1 == u { print $2 }' "$shadow")
  case "$have" in '!'* | '*'*) return 0 ;; esac
  set_password "$1" '!'
}

user=$(jq -r '.user.name // empty' "$record" 2>/dev/null || true)
if [ -z "$user" ]; then
  if [ -e "$file" ]; then say "the device has no enrolled user yet: the console password waits for the enrollment"; fi
  exit 0
fi
# A person's account with enroll's sudo rule, never root or a system account.
uid=$(awk -F: -v u="$user" '$1 == u { print $3 }' "$root/etc/passwd")
if [[ ! "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || [ "$user" = root ] || [[ ! "$uid" =~ ^[0-9]+$ ]] ||
  [ "$uid" -lt 1000 ] || [ "$uid" -ge 60000 ] || [ ! -f "$root/etc/sudoers.d/ironflock-$user" ]; then
  say "the enrolled user ${user@Q} is not an account the console password is for: nothing changes"
  exit 1
fi

if [ ! -e "$file" ] && [ ! -L "$file" ]; then
  lock "$user"
  say "no console password: $user's password is locked"
  exit 0
fi

refuse() {
  lock "$user"
  say "refused $file: $*; $user's password is locked"
  exit 1
}
[ ! -L "$file" ] && [ -f "$file" ] || refuse "not a file"
# Owner and mode, from ls: only the user that runs this may own it, and
# nobody else may read it.
read -r mode _ owner _ < <(ls -ln "$file")
[ "$owner" = "$(id -u)" ] || refuse "it does not belong to root"
[[ "$mode" == -rw-------* ]] || refuse "its mode is not 0600"
[ "$(wc -c <"$file" | tr -d ' ')" -le 512 ] || refuse "larger than 512 bytes"
[ "$(wc -l <"$file" | tr -d ' ')" -le 1 ] || refuse "more than one line"
hash=$(tr -d '\r\n' <"$file")
if [[ ! "$hash" =~ ^\$y\$[./A-Za-z0-9]+\$[./A-Za-z0-9]{1,86}\$[./A-Za-z0-9]{43}$ ]] &&
  [[ ! "$hash" =~ ^\$6\$(rounds=[0-9]+\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}$ ]]; then
  refuse "not a yescrypt (\$y\$) or SHA-512 (\$6\$) hash"
fi
set_password "$user" "$hash"
say "the console password is $user's"
