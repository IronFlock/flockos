#!/bin/sh
# /data could not be mounted (ironflockos-data-missing.service; ADR-0015). The
# device comes up on the root slot's own folders, as /etc/fstab mounts /data
# and its bind mounts with nofail. This says so as loudly as a device without
# a person at it can: on the console, in the journal and in
# /run/ironflockos/data-missing, which enroll and ironflockos-proxy read (they then
# take the IRONFLOCKOS partition's .flock and proxy.conf without removing them:
# what the device keeps now is lost with the next update). It also makes the
# folders of /data that the SSH host keys, the proxy and RAUC are written to.
set -eu
# IRONFLOCKOS_RUN, IRONFLOCKOS_DATA: for the unit tests only.
run=${IRONFLOCKOS_RUN:-/run/ironflockos}
d=${IRONFLOCKOS_DATA:-/data}
msg="THE DATA PARTITION COULD NOT BE MOUNTED: IronFlockOS runs on the root slot's own folders. The agent can start and reach IronFlock with a .flock on the IRONFLOCKOS partition; Docker and the apps do not run; what is written now is lost with the next update."
mkdir -p "$run"
printf '%s\n' "$msg" >"$run/data-missing"
mkdir -p "$d/etc/ssh" "$d/ironflockos" "$d/rauc" 2>/dev/null || true
echo "data-missing: $msg"
